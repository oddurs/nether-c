#!/bin/sh
# Conventional Commits, and the attribution ban.
set -eu
msg_file=$1
subject=$(sed -n '1p' "$msg_file")

# Allow merges and fixups through untouched.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|spec|perf|refactor|test|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -qE "$pattern"; then
  cat >&2 <<'MSG'
commit-msg: subject must be a Conventional Commit.

  type(scope): subject

  types: feat fix chore docs spec perf refactor test build ci style revert

  spec(strata): state the witness obligation for stratum 5
  fix(ledger): sort map keys before encoding
MSG
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters; keep it to 72" >&2
  exit 1
fi

case "$subject" in
  *.) echo "commit-msg: no trailing period on the subject" >&2; exit 1 ;;
esac

# The work is published under the owner's name.
#
# Anywhere in the message, not only on a `Co-authored-by:` line: the trailer is
# one shape this takes and a session link is another. `CLAUDE.md` is exempt as
# a filename, because it is what this repository calls the file that states the
# ban. `tests/attribution/run` applies the same rule to everything already
# here, which is the half a hook cannot do.
named='claude([^.]|$)|claude\.ai|anthropic|copilot|chatgpt|openai'
trailer='^[[:space:]]*(co-authored-by|assisted-by|generated-by|authored-by)[[:space:]]*:'
phrase='generated with|[[:<:]]AI[[:>:]]|🤖'

if grep -qiE "$named|$phrase" "$msg_file" \
  || grep -iE "$trailer" "$msg_file" | grep -qivE 'dependabot|oddurs@users\.noreply\.github\.com'; then
  cat >&2 <<'MSG'
commit-msg: attribution to a tool or model is not permitted in this repository.

  Not in a trailer, not in a session link, not in a footer. The work is
  published under the owner's name — CLAUDE.md, under NEVER.
MSG
  exit 1
fi
