def deepest(html: str) -> int:
    """How far down a section goes, read out of the section itself.

    `paint_nc` stains every `@n` it finds, so the deepest stain in a page is
    the deepest stratum that page talks about. The site's colour is therefore
    computed from the specification the same way a trace's depth is computed
    from its parts, rather than written into a table somebody has to remember
    to update. §7.3.2, applied to prose.
    """
    return max((int(m) for m in _RE_DEPTH_CLASS.findall(html)), default=0)


def load_sections() -> list[Section]:
    out: list[Section] = []
    for path in sorted(SPEC.glob("*.md")):
        if not path.name[0].isdigit():
            continue
        meta, body = split_front_matter(path.read_text(encoding="utf-8"))
        rendered = render(body)
        out.append(
            {
                "slug": path.stem,
                "section": meta.get("section", ""),
                "title": meta.get("title", path.stem),
                "status": meta.get("status", "draft"),
                "depth": deepest(rendered),
                "html": rendered,
            }
        )
    return out


_CHAPTER_IDEAS = {
    "00": "Setup, verification guarantee, and how to read this manual.",
    "09": "Spec reading order, graft, and the local Necropolis browser.",
}


def _extract_idea(section: str, body: str) -> str:
    m = _RE_ONE_IDEA.search(body)
    if m:
        idea = m.group(1).strip()
        return idea[0].upper() + idea[1:] if idea else ""
    return _CHAPTER_IDEAS.get(section, "")


def load_chapters() -> list[Chapter]:
    """The manual, which is a different document with a different job.

    The specification answers "what is the rule" and says each rule once. A
    newcomer needs "what do I type", in an order that introduces one idea at a
    time, and the two cannot be the same document without one of them getting
    worse. 0104.
    """
    out: list[Chapter] = []
    for path in sorted(MANUAL.glob("*.md")):
        meta, body = split_front_matter(path.read_text(encoding="utf-8"))
        sec = meta.get("section", "")
        out.append(
            {
                "slug": path.stem,
                "section": sec,
                "title": meta.get("title", path.stem),
                "status": meta.get("status", "draft"),
                "idea": _extract_idea(sec, body),
                "html": render(body),
            }
        )
    return out


def _fence_open(stripped: str) -> tuple[str, int] | None:
    for ch in ("`", "~"):
        if stripped.startswith(ch * 3):
            n = len(stripped) - len(stripped.lstrip(ch))
            rest = stripped[n:]
            if ch == "`" and "`" in rest:
                return None
            return (ch, n)
    return None


def _fence_close(stripped: str, fence: tuple[str, int]) -> bool:
    ch, n = fence
    if not stripped.startswith(ch * n):
        return False
    return stripped.lstrip(ch).strip() == ""


def release_anchor(tag: str) -> str:
    return tag.lower().replace(".", "-")


@functools.lru_cache(maxsize=1)
def load_releases() -> list[Release]:
    """Every released version in CHANGELOG.md, parsed outside code fences."""
    text = CHANGELOG.read_text(encoding="utf-8")
    fence: tuple[str, int] | None = None
    releases: list[Release] = []
    current: tuple[str, str, list[str]] | None = None

    def flush() -> None:
        nonlocal current
        if current is None:
            return
        version, date, body_lines = current
        body_md = "".join(body_lines).strip()
        if not body_md:
            raise RuntimeError(f"bake: CHANGELOG.md section for {version} is empty")
        releases.append({
            "version": version,
            "tag": f"v{version}",
            "date": date,
            "body_md": body_md,
        })
        current = None

    for line in text.splitlines(keepends=True):
        indent = len(line) - len(line.lstrip(" "))
        stripped = line[indent:] if indent <= 3 and not line.startswith("\t") else ""
        if fence is not None:
            if stripped and _fence_close(stripped, fence):
                fence = None
            if current is not None:
                current[2].append(line)
            continue
        opened = _fence_open(stripped) if stripped else None
        if opened is not None:
            fence = opened
            if current is not None:
                current[2].append(line)
            continue
        if _RE_LINK_DEF.match(line):
            flush()
            break
        m = _RE_RELEASE_HEAD.match(line)
        if m:
            flush()
            version = m.group(1).strip()
            date = (m.group(2) or "").strip()
            if version.lower() != "unreleased":
                current = (version, date, [])
            continue
        if _RE_NEXT_H2.match(line):
            flush()
            continue
        if current is not None:
            current[2].append(line)

    flush()
    if not releases:
        raise RuntimeError("bake: CHANGELOG.md has no released versions")
    return releases


def load_supported_version(expected_tag: str) -> str:
    """`## Supported versions` from SECURITY.md, checked against the latest release."""
    text = SECURITY.read_text(encoding="utf-8")
    fence: tuple[str, int] | None = None
    capturing = False
    out: list[str] = []
    for line in text.splitlines(keepends=True):
        indent = len(line) - len(line.lstrip(" "))
        stripped = line[indent:] if indent <= 3 and not line.startswith("\t") else ""
        if fence is not None:
            if stripped and _fence_close(stripped, fence):
                fence = None
            if capturing:
                out.append(line)
            continue
        opened = _fence_open(stripped) if stripped else None
        if opened is not None:
            fence = opened
            if capturing:
                out.append(line)
            continue
        if not capturing:
            if line.strip() == "## Supported versions":
                capturing = True
            continue
        if _RE_NEXT_H2.match(line):
            break
        out.append(line)
    prose = "".join(out).strip()
    if not prose:
        raise RuntimeError("bake: SECURITY.md has no `## Supported versions` section")
    m = _RE_SUPPORTED_TAG.search(prose)
    if not m:
        raise RuntimeError("bake: SECURITY.md `## Supported versions` names no release tag")
    if m.group(1) != expected_tag:
        raise RuntimeError(
            f"bake: SECURITY.md names {m.group(1)} as supported, "
            f"but CHANGELOG.md latest release is {expected_tag}"
        )
    return prose


def load_release_targets() -> list[str]:
    """Build targets from `.github/workflows/release.yml` so the site never drifts."""
    text = RELEASE_WORKFLOW.read_text(encoding="utf-8")
    targets = [
        m.group(1)
        for line in text.splitlines()
        if (m := _RE_WORKFLOW_TARGET.match(line))
    ]
    if not targets:
        raise RuntimeError("bake: no release targets found in .github/workflows/release.yml")
    return targets


def navbar(current: str, depth: int, *, exact: bool = True) -> str:
    up = "../" if depth else ""
    # Five documents, named for what they are. The specification used to be
    # labelled "manual", which it is not and says so in its first paragraph.
    links = [
        ("index", f"{up}index.html", "front desk"),
        ("manual", f"{up}manual/index.html", "manual"),
        ("spec", f"{up}spec/index.html", "spec"),
        ("releases", f"{up}releases.html", "releases"),
        ("specimen", f"{up}specimen.html", "the face"),
    ]
    items = []
    for name, href, label in links:
        if name == current:
            cur = ' aria-current="page"' if exact else ' class="current"'
        else:
            cur = ""
        items.append(f'<a href="{href}"{cur}>{label}</a>')
    items.append(f'<a href="{REPO}" target="_blank" rel="noreferrer noopener">source</a>')
    items.append(f'<a href="{REPO}/blob/main/ROADMAP.md" target="_blank" rel="noreferrer noopener">roadmap</a>')
    body = "".join(items)
    return (
        f'<nav class="bar" aria-label="Primary">{body}'
        f'<button class="lamp" type="button" data-lamp-toggle>lamp: <span data-lamp-state>out</span></button></nav>'
    )


def contents_nav(
    entries: list[Section] | list[Chapter],
    current: str,
    *,
    label: str,
    heading: str,
    prefix: str = "",
) -> str:
    """Whole-document directory beside every spec section or manual chapter."""
    items = []
    for entry in entries:
        num = f'<span class="dir-num">{prefix}{esc(entry["section"])}</span>'
        title = f'<span>{esc(entry["title"])}</span>'
        if entry["slug"] == current:
