@functools.lru_cache(maxsize=1)
def _load_template() -> str:
    return (SITE / "template.html").read_text(encoding="utf-8")


def extract_description(body_html: str, fallback: str = DEFAULT_DESCRIPTION) -> str:
    """First substantive paragraph from rendered HTML, trimmed for meta tags."""
    for m in _RE_PARA.finditer(body_html):
        attrs = m.group(1) or ""
        if any(cls in attrs for cls in ('class="c"', 'class="panel-label"', 'class="small"')):
            continue
        plain = html.unescape(_RE_TAGS.sub("", m.group(2)))
        plain = _RE_WS.sub(" ", plain).strip()
        if len(plain) < 30:
            continue
        if len(plain) > 160:
            cut = plain[:159].rsplit(" ", 1)[0].rstrip(".,;:")
            return cut + "..."
        return plain
    return fallback


def page(
    title: str,
    body: str,
    *,
    current: str,
    depth: int,
    directory: str = "",
    exact: bool = True,
    url_path: str = "",
    description: str = "",
) -> str:
    tpl = _load_template()
    up = "../" if depth else ""
    # The front page is already called Nether C; appending the site name to it
    # gave every tab "Nether C — Nether C".
    safe_title = esc(title)
    full = safe_title if title == SITE_NAME else f"{safe_title} &mdash; {SITE_NAME}"
    desc = esc(description or extract_description(body))
    canonical = f"{SITE_URL}/{url_path.lstrip('/')}"
    if not directory:
        entries = [
            ("start", "Start here"), ("first-program", "First burial"),
            ("nine-strata", "Nine strata"), ("six-rites", "The six rites"),
            ("manual", "The manual"), ("specification", "Specification"),
            ("status", "Project status"), ("the-face", "The face"),
        ]
        directory = '<nav class="desk-directory" aria-label="Front desk contents">' + "".join(
            f'<a href="{up}index.html#{anchor}"><span class="dir-num" aria-hidden="true">{n:02}</span><span>{label}</span></a>'
            for n, (anchor, label) in enumerate(entries)
        ) + "</nav>"
    subs = {
        "{{TITLE}}": safe_title,
        "{{FULLTITLE}}": full,
        "{{DESCRIPTION}}": desc,
        "{{URL}}": canonical,
        "{{UP}}": up,
        "{{NAV}}": navbar(current, depth, exact=exact),
        "{{DIRECTORY}}": directory,
        "{{BODY}}": body,
    }
    output = _RE_TPL_SLOT.sub(lambda m: subs[m.group(0)], tpl)

    def themed_image(match: re.Match[str]) -> str:
        before, src, after = match.groups()
        lit = src.removesuffix(".gif") + "-lit.gif"
        still = " data-still" if Path(src).name in ANIMATED_GIFS else ""
        return f'<img{before}src="{src}" data-dark-src="{src}" data-lit-src="{lit}"{still}{after}>'

    return _RE_GIF_IMG.sub(themed_image, output)


def _grid_bits(rows: tuple[str, ...]) -> str:
    return "\n".join(r.replace("#", "█").replace(".", "·") for r in rows)


def _specimen_card(
    ch: str,
    reg: dict[str, tuple[str, ...]],
    bol: dict[str, tuple[str, ...]],
    same: frozenset[str],
) -> str:
    code = ord(ch)
    name = unicodedata.name(ch, f"U+{code:04X}")
    meta = "SAME" if ch in same else "400 + 700"
    sizes = "".join(
        f'<div class="glyph-size"><span class="glyph-px">{px}</span>'
        f'<span class="s{px}">{esc(ch)}</span>'
        f'<strong class="s{px}">{esc(ch)}</strong></div>'
        for px in (8, 16, 24, 32)
    )
    return (
        f'<article class="glyph-card" id="u-{code:04x}" data-codepoint="U+{code:04X}">'
        f'<header class="glyph-head"><code>U+{code:04X}</code>'
        f'<span class="glyph-meta">{meta}</span>'
        f'<span class="glyph-name">{esc(name)}</span></header>'
        f'<div class="glyph-grids">'
        f'<figure class="glyph-cell"><figcaption>400</figcaption>'
        f'<pre class="glyph-grid" data-weight="regular">{_grid_bits(reg[ch])}</pre></figure>'
        f'<figure class="glyph-cell"><figcaption>700</figcaption>'
        f'<pre class="glyph-grid" data-weight="bold">{_grid_bits(bol[ch])}</pre></figure>'
        f'</div>'
        f'<div class="glyph-sizes">{sizes}</div>'
        f"</article>"
    )


def _specimen_scale() -> str:
    return "".join(
        f'<div class="scale-row">'
        f'<p class="c">{px}px &middot; {px // 8}&times; cell &middot; {px * 7 // 8}px advance</p>'
        f'<p class="scale-sample s{px}">{esc(sample)}</p>'
        f'<p class="scale-sample s{px}"><strong>{esc(sample)}</strong></p>'
        f"</div>"
        for px, sample in (
            (8, "NETHER C / DESK 00 · 0123456789 · U0 bury(Str p) @0 -> #efed9b2a"),
            (16, "Nothing runs. A program is buried; what ships is a trace."),
            (24, "■ Section 02 · Γ; δ ⊢ e : τ@d"),
            (32, "██ NOTHING RUNS · @0..@8"),
        )
    )


