def _build_manual(chapters: list[Chapter]) -> dict[Path, str]:
    cards = "".join(
        f'<a class="chapter" href="{c["slug"]}.html">'
        f'<span class="n" aria-hidden="true">{esc(c["section"])}</span>'
        f'<span class="chapter-body">'
        f'<span class="t">{esc(c["title"])}</span>'
        f'<span class="chapter-idea">{esc(c["idea"])}</span>'
        f"</span></a>"
        for c in chapters
    )
    manual_body = (
        "<h1>The manual</h1>"
        "<p>Ten short chapters, one idea in each. Start from an empty directory, "
        "bury four programs, grant a capability, and replay a trace with the "
        "world switched off.</p>"
        '<p class="arrival-actions">'
        '<a class="btn btn-primary" href="00-a-way-in.html">Start at 00 A way in &rarr;</a>'
        '<a class="btn" href="../releases.html#install">Install nether</a></p>'
        '<div class="box"><p><strong>Every command in these chapters runs on every '
        "build</strong> against <code>nether</code> via "
        f'<a href="{REPO}/blob/main/tests/transcripts/run">tests/transcripts/run</a>. '
        "Printed output is checked byte for byte; documentation that lies fails "
        "the build.</p></div>"
        '<div class="chapters">' + cards + "</div>"
        f'<p class="small">Canonical Markdown lives in '
        f'<a href="{REPO}/tree/main/docs/manual">docs/manual/</a>. '
        'Looking for formal rules? Read <a href="../spec/index.html">the specification</a>.</p>'
    )
    files: dict[Path, str] = {
        SITE / "manual" / "index.html": page(
            "The manual",
            manual_body,
            current="manual",
            depth=1,
            directory=contents_nav(chapters, "", label="Manual contents", heading="manual/"),
            exact=True,
            url_path="manual/",
            description="The Nether C manual: ten short chapters, every command executed and checked against the compiler on every build.",
            pane_title="manual/",
        )
    }
    for idx, c in enumerate(chapters):
        head = (
            f'<p class="c meta-bar">'
            f'<span>chapter {esc(c["section"])}</span> '
            f'<span><a href="{REPO}/blob/main/docs/manual/{c["slug"]}.md">edit the source</a></span></p>'
        )
        prev_link = (
            f'<a class="btn" href="{chapters[idx - 1]["slug"]}.html">&larr; '
            f'{esc(chapters[idx - 1]["section"])} {esc(chapters[idx - 1]["title"])}</a>'
            if idx > 0
            else '<a class="btn" href="index.html">&larr; All chapters</a>'
        )
        next_link = (
            f'<a class="btn" href="{chapters[idx + 1]["slug"]}.html">'
            f'{esc(chapters[idx + 1]["section"])} {esc(chapters[idx + 1]["title"])} &rarr;</a>'
            if idx + 1 < len(chapters)
            else '<a class="btn" href="index.html">All chapters &rarr;</a>'
        )
        pager = (
            '<nav class="chapter-pager" aria-label="Chapter navigation">'
            f"{prev_link}{next_link}</nav>"
        )
        files[SITE / "manual" / f'{c["slug"]}.html'] = page(
            c["title"],
            head + c["html"] + pager,
            current="manual",
            depth=1,
            directory=contents_nav(chapters, c["slug"], label="Manual contents", heading="manual/"),
            exact=False,
            url_path=f'manual/{c["slug"]}.html',
            pane_title=f'manual/{c["slug"]}.md',
        )
    return files


