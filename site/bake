        else:
            items.append(f'<li><a href="{esc(entry["slug"])}.html">{num}{title}</a></li>')
    return (
        f'<nav class="contents" aria-label="{label}">'
        f'<p>{heading}</p><ol role="list">' + "".join(items) + "</ol></nav>"
    )


