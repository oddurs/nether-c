# ── the little markdown ────────────────────────────────────────────────────

KEYWORDS = {
    "descend", "seal", "shade", "look", "opaque", "demand", "if", "else",
    "while", "for", "return", "break", "continue", "struct", "typedef",
    "sizeof", "true", "false",
}
TYPES = {"U0", "I64", "Bytes", "Str", "Cairn", "Shade", "Answer", "Refusal", "Bool"}

_RE_TAGS = re.compile(r"<[^>]+>")
_RE_SLUG_DROP = re.compile(r"[^\w\s-]")
_RE_WS = re.compile(r"\s+")
_RE_SPEC_HREF = re.compile(r"\.\./\.\./spec/([\w.-]+)\.md(#.*)?")
_RE_TOP_SPEC_HREF = re.compile(r"spec/([\w.-]+)\.md(#.*)?")
_RE_ROOT_HREF = re.compile(r"\.\./\.\./([\w.-]+\.md)")
_ROOT_REPO_FILES = frozenset({
    "SECURITY.md", "LICENSE", "CONTRIBUTING.md", "ROADMAP.md", "CHANGELOG.md", "README.md",
})
_RE_LOCAL_MD = re.compile(r"[\w.-]+\.md(#.*)?")
_RE_CODE_SPAN = re.compile(r"(`+)((?:(?!\1).)+?)\1")
_RE_LINK = re.compile(r"\[([^\]]+)\]\(((?:[^()\s]|\([^()\s]*\))+)\)")
_RE_CODE_TOK = re.compile(r"\x00C(\d+)\x00")
_RE_LINK_TOK = re.compile(r"\x00L(\d+)\x00")
_RE_BOLD = re.compile(r"\*\*([^*]+)\*\*")
_RE_ITALIC = re.compile(r"(?<![\w*])\*([^*\n]+)\*(?![\w*])")
_RE_CTRL = re.compile(r"[\x00-\x20]+")
_RE_SCHEME = re.compile(r"^[a-z][a-z0-9+.-]*:")
_RE_DEPTH_DIGIT = re.compile(r"[^0-8]")
_RE_PROMPT = re.compile(r"^(\s*)\$ (.*)$")
_RE_NETHER_CMD = re.compile(r"^(nether)(\s+)(\w+)")
_RE_CAIRN_SHORT = re.compile(r"\b([0-9a-f]{8})\b")
_RE_DIAG = re.compile(r"^(\s*)(error|warning)(:)")
_RE_FENCE = re.compile(r"^(`{3,})(.*)$")
_RE_HEADING = re.compile(r"^(#{1,6})\s+(.*)$")
_RE_HR = re.compile(r"^(-{3,}|={3,})\s*$")
_RE_TABLE_SEP = re.compile(r"^\s*\|[\s:|-]+\|\s*$")
_RE_QUOTE_PREFIX = re.compile(r"^>\s?")
_RE_LIST_ITEM = re.compile(r"^(\s*)([-*]|\d+\.)\s+(.*)$")
_RE_TASK_OPEN = re.compile(r"^\[ \]\s*")
_RE_TASK_DONE = re.compile(r"^\[x\]\s*")
_RE_STRATUM = re.compile(r"[0-8]")
_RE_DEPTH_CLASS = re.compile(r'class="d([0-8])"')
_RE_PARA = re.compile(r"<p(?:\s+([^>]*))?>(.*?)</p>", re.S)
_RE_TPL_SLOT = re.compile(r"\{\{(?:TITLE|FULLTITLE|DESCRIPTION|URL|UP|VERSION|NAV|DIRECTORY|BODY)\}\}")
_RE_GIF_IMG = re.compile(r'<img\b([^>]*?)src="([^"]+\.gif)"([^>]*)>')
_RE_FRONT_SLOT = re.compile(r"\{\{(START_SPEC|DESCENT|HOLES|LATEST_RELEASE|LATEST_TAG)\}\}")
_RE_ONE_IDEA = re.compile(r"^>\s*One idea:\s*\*\*(.+?)\*\*\s*$", re.M)
_RE_RELEASE_HEAD = re.compile(r"^##\s+\[([^\]]+)\](?:\s*-\s*(\d{4}-\d{2}-\d{2}))?\s*$")
_RE_NEXT_H2 = re.compile(r"^##\s")
_RE_LINK_DEF = re.compile(r"^\[[^\]]+\]:\s+\S+")
_RE_SUPPORTED_TAG = re.compile(r"`(v\d+\.\d+\.\d+[^`]*)`")
_RE_WORKFLOW_TARGET = re.compile(r"^\s*-\s*target:\s*([A-Za-z0-9_-]+)\s*$")


def esc(s: str) -> str:
    return html.escape(s, quote=True)


def slug(text: str) -> str:
    """GitHub's heading anchors, which the spec's internal links assume."""
    text = _RE_TAGS.sub("", text)
    text = _RE_SLUG_DROP.sub("", text.strip().lower())
    return _RE_WS.sub("-", text)


def rewrite_href(href: str) -> str:
    if href.startswith("../ROADMAP.md"):
        return f"{REPO}/blob/main/ROADMAP.md"
    # The manual is written in docs/manual/ and baked into site/manual/, so a
    # link it makes to `../../spec/06-evaluation.md` has one fewer level to
    # climb on the site than in the repository, and lands on a page.
    m = _RE_SPEC_HREF.fullmatch(href)
    if m:
        return f"../spec/{m.group(1)}.html{m.group(2) or ''}"
    # Root-level documents like CHANGELOG.md and SECURITY.md are baked at
    # depth 0, where `spec/08-rites.md` maps straight to `spec/08-rites.html`.
    m = _RE_TOP_SPEC_HREF.fullmatch(href)
    if m:
        return f"spec/{m.group(1)}.html{m.group(2) or ''}"
    # Anything else it reaches for at the root of the repository is a file
    # nothing bakes, such as CONTRIBUTING, so send the reader to the source.
    m = _RE_ROOT_HREF.fullmatch(href)
    if m:
        return f"{REPO}/blob/main/{m.group(1)}"
    if href.split("#", 1)[0] in _ROOT_REPO_FILES:
        return f"{REPO}/blob/main/{href}"
    if _RE_LOCAL_MD.fullmatch(href):
        return href.replace(".md", ".html", 1)
    return href


def _emphasis(s: str) -> str:
    s = _RE_BOLD.sub(r"<strong>\1</strong>", s)
    return _RE_ITALIC.sub(r"<em>\1</em>", s)


def inline(text: str) -> str:
    """Inline markdown. Code spans and links are extracted before emphasis."""
    text = text.replace("\x00", "")
    code_spans: list[str] = []
    link_spans: list[str] = []

    def expand_code(s: str) -> str:
        return _RE_CODE_TOK.sub(lambda m: code_spans[int(m.group(1))], s)

    def stash_code(m: re.Match[str]) -> str:
        inner = m.group(2)
        if len(inner) >= 2 and inner.startswith(" ") and inner.endswith(" ") and inner.strip():
            inner = inner[1:-1]
        code_spans.append(f"<code>{esc(inner)}</code>")
        return f"\x00C{len(code_spans) - 1}\x00"

    def stash_link(m: re.Match[str]) -> str:
        raw_label, raw_href = m.group(1), rewrite_href(m.group(2))
        label = expand_code(_emphasis(esc(raw_label)))
        cleaned = _RE_CTRL.sub("", raw_href)
        lower = cleaned.lower()
        has_scheme = bool(_RE_SCHEME.match(lower))
        first_seg = cleaned.split("/", 1)[0].split("?", 1)[0].split("#", 1)[0]
        allowed = (
            "\x00" not in raw_href
            and not cleaned.startswith(("//", "\\\\", "/\\", "\\/"))
            and (
                lower.startswith(("http://", "https://", "mailto:"))
                or (not has_scheme and ":" not in first_seg and "\\" not in first_seg)
            )
        )
        if not allowed:
            link_spans.append(label)
            return f"\x00L{len(link_spans) - 1}\x00"
        ext = (
            ' target="_blank" rel="noreferrer noopener"'
            if lower.startswith(("http://", "https://"))
            else ""
        )
        link_spans.append(f'<a href="{esc(raw_href)}"{ext}>{label}</a>')
        return f"\x00L{len(link_spans) - 1}\x00"

    text = _RE_CODE_SPAN.sub(stash_code, text)
    text = _RE_LINK.sub(stash_link, text)
    text = _emphasis(esc(text))
    text = _RE_LINK_TOK.sub(lambda m: link_spans[int(m.group(1))], text)
    return expand_code(text)


# ── syntax colouring ───────────────────────────────────────────────────────

NC_TOKEN = re.compile(
    r"(//[^\n]*)"                          # 1 line comment
    r"|(/\*[\s\S]*?\*/)"                   # 2 block comment
    r"|(b?\"(?:[^\"\\\n]|\\.)*\")"         # 3 string
    r"|(@\s?[0-8])"                        # 4 depth
    r"|\b(0x[0-9a-fA-F_]+|0b[01_]+|\d[\d_]*)\b"  # 5 number
    r"|\b([A-Za-z_][A-Za-z0-9_]*)\b"       # 6 word
)


def paint_nc(src: str) -> str:
    out, last = [], 0
    for m in NC_TOKEN.finditer(src):
        out.append(esc(src[last:m.start()]))
        last = m.end()
        if m.group(1) or m.group(2):
            out.append(f'<span class="c">{esc(m.group(1) or m.group(2))}</span>')
        elif m.group(3):
            out.append(f'<span class="s">{esc(m.group(3))}</span>')
        elif m.group(4):
            d = _RE_DEPTH_DIGIT.sub("", m.group(4))
            out.append(f'<span class="d{d}">{esc(m.group(4))}</span>')
        elif m.group(5):
            out.append(f'<span class="n">{esc(m.group(5))}</span>')
        else:
            w = m.group(6)
            cls = "k" if w in KEYWORDS else "t" if w in TYPES else None
            out.append(f'<span class="{cls}">{esc(w)}</span>' if cls else esc(w))
    out.append(esc(src[last:]))
    return "".join(out)


def paint_console(src: str) -> str:
    lines = []
    for line in src.split("\n"):
        m = _RE_PROMPT.match(line)
        if m:
            cmd = _RE_NETHER_CMD.sub(r'\1\2<span class="k">\3</span>', esc(m.group(2)))
            lines.append(f'{m.group(1)}<span class="p">$</span> {cmd}')
            continue
        out = esc(line)
        out = _RE_CAIRN_SHORT.sub(r'<span class="h">\1</span>', out)
        out = _RE_DIAG.sub(r'\1<span class="e">\2\3</span>', out)
        lines.append(out)
    return "\n".join(lines)


def paint(src: str, lang: str) -> str:
    if lang in ("c", "nc", "signatures"):
        return paint_nc(src)
    if lang in ("console", "sh", "shell"):
        return paint_console(src)
    return esc(src)


LANG_LABEL = {
    "c": "nether c",
    # A signature and a semicolon: a notation §09 lists the prelude in, and
    # not something §04 parses. Painted the same way and labelled differently,
    # because it reads like the language and is not it.
    "signatures": "prelude signatures",
    "console": "shell",
    "ebnf": "grammar",
    "": "",
}


# ── block parser ───────────────────────────────────────────────────────────

def _render_fence(lines: list[str], start: int, fence_len: int, lang: str) -> tuple[str, int]:
    close_re = re.compile(r"^`{" + str(fence_len) + r",}\s*$")
    i = start + 1
    body: list[str] = []
    while i < len(lines) and not close_re.match(lines[i]):
        body.append(lines[i])
        i += 1
    label = LANG_LABEL.get(lang, lang)
    cap = f"<figcaption>{esc(label)}</figcaption>" if label else ""
    html_out = (
        f'<figure class="listing">{cap}'
        f'<pre><code>{paint(chr(10).join(body), lang)}</code></pre></figure>'
    )
    return html_out, i + 1


def _split_table_row(row: str) -> list[str]:
    inner = row.strip()
    if inner.startswith("|"):
        inner = inner[1:]
    if inner.endswith("|") and not inner.endswith(r"\|"):
        inner = inner[:-1]
    parts: list[str] = []
    buf: list[str] = []
    in_code = False
    k = 0
    while k < len(inner):
        ch = inner[k]
        if ch == "\\" and not in_code and k + 1 < len(inner) and inner[k + 1] == "|":
            buf.append("|")
            k += 2
            continue
        if ch == "`":
            in_code = not in_code
            buf.append(ch)
            k += 1
            continue
        if ch == "|" and not in_code:
            parts.append("".join(buf).strip())
            buf.clear()
            k += 1
            continue
        buf.append(ch)
        k += 1
    parts.append("".join(buf).strip())
    return parts


def _render_table(lines: list[str], start: int) -> tuple[str, int]:
    head = _split_table_row(lines[start])
    aligns = [
        "center" if c.strip().startswith(":") and c.strip().endswith(":")
        else "right" if c.strip().endswith(":")
        else "left"
        for c in _split_table_row(lines[start + 1])
    ]
    i = start + 2
    rows: list[list[str]] = []
    while i < len(lines) and lines[i].lstrip().startswith("|"):
        rows.append(_split_table_row(lines[i]))
        i += 1
    thead = ""
    if any(c.strip() for c in head):
        th = "".join(
            f'<th class="align-{aligns[n] if n < len(aligns) else "left"}">{inline(c)}</th>'
            for n, c in enumerate(head)
        )
        thead = f"<thead><tr>{th}</tr></thead>"
    tb = "".join(
        "<tr>"
        + "".join(
            f'<td class="align-{aligns[n] if n < len(aligns) else "left"}">{inline(c)}</td>'
            for n, c in enumerate(r)
        )
        + "</tr>"
        for r in rows
    )
    return f'<div class="scroll"><table>{thead}<tbody>{tb}</tbody></table></div>', i


def _parse_list(lines: list[str], start_i: int, base_indent: int) -> tuple[str, int]:
    first = _RE_LIST_ITEM.match(lines[start_i])
    assert first is not None
    ordered = first.group(2) not in ("-", "*")
    tag = "ol" if ordered else "ul"
    items: list[tuple[str, str, list[str]]] = []
    idx = start_i
    while idx < len(lines):
        mm = _RE_LIST_ITEM.match(lines[idx])
        if mm:
            indent = len(mm.group(1))
            if indent > base_indent and items:
                sub_html, idx = _parse_list(lines, idx, indent)
                items[-1][2].append(sub_html)
                continue
            if indent < base_indent:
                break
            if (mm.group(2) not in ("-", "*")) != ordered:
                break
            text = mm.group(3)
            prefix = ""
            if _RE_TASK_OPEN.match(text):
                prefix = '<span class="c">[ ]</span> '
                text = _RE_TASK_OPEN.sub("", text)
            elif _RE_TASK_DONE.match(text):
                prefix = '<span class="s">[x]</span> '
                text = _RE_TASK_DONE.sub("", text)
            items.append((prefix, text, []))
            idx += 1
            continue
        if (
            lines[idx].startswith(" " * (base_indent + 2))
            and lines[idx].strip()
            and items
            and not items[-1][2]
        ):
            prefix, prev, children = items[-1]
            items[-1] = (prefix, prev + " " + lines[idx].strip(), children)
            idx += 1
            continue
        break
    body = "".join(
        f"<li>{prefix}{inline(it)}{''.join(children)}</li>"
        for prefix, it, children in items
    )
    return f"<{tag}>{body}</{tag}>", idx


def render(md: str, seen_anchors: dict[str, int] | None = None) -> str:
    lines = md.split("\n")
    out: list[str] = []
    i = 0

    def flush_para(buf: list[str]) -> None:
        if buf:
            out.append(f"<p>{inline(' '.join(buf).strip())}</p>")
            buf.clear()

    para: list[str] = []
    if seen_anchors is None:
        seen_anchors = {}

    while i < len(lines):
        line = lines[i]

        fm = _RE_FENCE.match(line)
        if fm and "`" not in fm.group(2):
            flush_para(para)
            block, i = _render_fence(lines, i, len(fm.group(1)), fm.group(2).strip())
            out.append(block)
            continue

        m = _RE_HEADING.match(line)
        if m:
            flush_para(para)
            level, text = len(m.group(1)), inline(m.group(2))
            base = slug(m.group(2))
            n_seen = seen_anchors.get(base, 0)
            seen_anchors[base] = n_seen + 1
            anchor = base if n_seen == 0 else f"{base}-{n_seen}"
            out.append(f'<h{level} id="{anchor}"><a href="#{anchor}">{text}</a></h{level}>')
            i += 1
            continue

        if _RE_HR.match(line):
            flush_para(para)
            out.append("<hr>")
            i += 1
            continue

        if line.lstrip().startswith("|") and i + 1 < len(lines) and _RE_TABLE_SEP.match(lines[i + 1]):
            flush_para(para)
            table_html, i = _render_table(lines, i)
            out.append(table_html)
            continue

        if line.startswith(">"):
            flush_para(para)
            body = []
            while i < len(lines) and (lines[i].startswith(">") or (body and lines[i].strip() and not lines[i].startswith(("#", "```", "|")))):
                body.append(_RE_QUOTE_PREFIX.sub("", lines[i]))
                i += 1
            out.append(f"<blockquote>{render(chr(10).join(body), seen_anchors)}</blockquote>")
            continue

        m = _RE_LIST_ITEM.match(line)
        if m:
            flush_para(para)
            list_html, i = _parse_list(lines, i, len(m.group(1)))
            out.append(list_html)
            continue

        if not line.strip():
            flush_para(para)
            i += 1
            continue

        para.append(line.strip())
        i += 1

    flush_para(para)
    return "".join(out)


# ── front matter ───────────────────────────────────────────────────────────

def split_front_matter(raw: str) -> tuple[dict[str, str], str]:
    if not raw.startswith("---\n"):
        return {}, raw
    end = raw.find("\n---\n", 3)
    if end < 0:
        if raw.endswith("\n---"):
            end = len(raw) - 4
            body = ""
        else:
            return {}, raw
    else:
        body = raw[end + 5:]
    meta = {}
    for line in raw[4:end].split("\n"):
        if not line or line[0].isspace() or line.startswith("-"):
            continue
        if ":" in line:
            k, v = line.split(":", 1)
            val = v.strip()
            if len(val) >= 2 and val[0] == val[-1] and val[0] in ('"', "'"):
                val = val[1:-1]
            meta[k.strip()] = val
    return meta, body


# ── the board, which is where the state of the project actually lives ───────
#
# A page that states the state of the project in prose is a page that was true
# once. The banner said "nothing is implemented" for as long as it took to
# implement everything, and being a GIF it did not even change colour. So the
# two blocks that describe where the work has got to are generated from
# `cairn/items/`, and `site/bake --check` fails the day the board moves and
# the page has not been rebaked. 0179.

#: The descent, in the order it is descended. A milestone not named here is a
#: milestone somebody added without deciding where it goes.
DESCENT = [
    "codex", "lamp", "ledger", "calculus", "surface",
    "rites", "world", "necropolis", "futamura",
]

#: What a status means to a reader who has not read the schema.
SAID = {
    "buried": "buried",
    "descending": "descending",
    "starved": "starved",
    "marked": "still owed",
    "unmarked": "still owed",
}


def load_board() -> tuple[list[dict[str, str]], list[dict[str, str]]]:
    """Every milestone in descent order, and every item still owed."""
    milestones: dict[str, dict[str, str]] = {}
    owed: list[dict[str, str]] = []
    for path in sorted(BOARD.glob("*.md")):
        meta, _ = split_front_matter(path.read_text(encoding="utf-8"))
        if meta.get("type") == "milestone":
            milestones[meta.get("key", "")] = meta
        elif meta.get("status") in ("unmarked", "marked", "descending", "starved"):
            owed.append(meta)

    ordered = [milestones[k] | {"key": k} for k in DESCENT if k in milestones]
    owed.sort(key=lambda m: (DESCENT.index(m["milestone"]) if m.get("milestone") in DESCENT
                             else len(DESCENT), m.get("priority", "p9"), m.get("id", "")))
    return ordered, owed


def titled(meta: dict[str, str], width: int) -> str:
    """A title, unquoted, cut to the column, and padded before it is escaped.

    Padding after escaping counts `&#x27;` as six characters and puts the
    stratum hard against the last letter of a long one, which is how the
    first version of this printed `does not existstratum 0`.
    """
    text = meta.get("title", "").strip("'\"")
    if len(text) > width:
        text = text[: width - 1] + "\u2026"
    return esc(text.ljust(width))


def numeral(n: int) -> str:
    """A plain number, right-aligned to two columns.

    Not `bury`'s ①..⑳. A circled numeral is drawn in a six by eight cell here
    and only the first one reads at that size: the ring eats the digit. The
    rites print them because a terminal font has room; this does not, and a
    numeral nobody can read is worse than the one that is not a quotation.
    """
    return f"{n:>2}"


def plural(n: int, singular: str, plural_word: str | None = None) -> str:
    return f"{n} {singular if n == 1 else (plural_word or singular + 's')}"


def descent_block(milestones: list[dict[str, str]], owed: list[dict[str, str]]) -> str:
    """Where the work has got to, in the shape `nether strata` prints."""
    left = sum(1 for m in milestones if m.get("status") != "buried")
    rows = []
    for n, m in enumerate(milestones, 1):
        state = SAID.get(m.get("status", ""), m.get("status", ""))
        here = sum(1 for i in owed if i.get("milestone") == m["key"])
        note = plural(here, "hole") if here else ""
        cls = "d0" if m.get("status") == "buried" else "d5"
        rows.append(
            f'  <span class="{cls}">{numeral(n)}</span>  '
            f'{titled(m, 22)}{esc(f"{state:<12}")}{esc(note)}'
        )
    body = "\n".join(rows)
    return (
        '<figure class="listing"><figcaption>the descent, from '
        'cairn/items/</figcaption><pre><code>'
        f'depth {len(milestones) - left} of {len(milestones)}   '
        f'{plural(len(owed), "hole")} still owed\n\n{body}\n</code></pre></figure>'
    )


def holes_block(owed: list[dict[str, str]]) -> str:
    """What the world still owes, in the shape `nether bury` prints a hole."""
    shown = [i for i in owed if i.get("priority") in ("p0", "p1")][:8]
    rows = []
    for n, i in enumerate(shown, 1):
        stratum = i.get("stratum", "").strip("'\"") or "0"
        if not _RE_STRATUM.fullmatch(stratum):
            stratum = "0"
        rows.append(
            f'  hole <span class="d{stratum}">{numeral(n)}</span>  '
            f'{titled(i, 42)}  '
            f'<span class="d{stratum}">stratum {stratum}</span>  '
            f'{esc(i.get("milestone", ""))}'
        )
    rest = len(owed) - len(shown)
    tail = f"\n  ... and {rest} more, in the roadmap" if rest > 0 else ""
    body = "\n".join(rows)
    return (
        '<figure class="listing"><figcaption>what the world still owes'
        '</figcaption><pre><code>'
        f'holes {len(owed)}\n\n{body}{tail}\n</code></pre></figure>'
    )


