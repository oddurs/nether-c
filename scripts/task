#!/bin/sh
# The seam. CI, the git hooks and scripts/agent know only these verbs;
# everything stack-specific lives here and nowhere else.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

case "${1:-}" in
  fmt)
    cargo fmt --all
    ;;
  fmt:check)
    cargo fmt --all -- --check
    ;;
  lint)
    cargo clippy --workspace --all-targets -- -D warnings
    ;;
  test)
    cargo test --workspace
    "$0" workflow:check
    "$0" graph:check
    # Every code sample in the documentation is a fixture. Documentation that
    # lies fails the build.
    python3 tests/transcripts/run
    # The Decay Rule is only worth having if it actually fails.
    python3 tests/decay/run
    # The complemented VGA palette clears WCAG AA on both grounds, or it changes.
    python3 tests/contrast/run
    # Nothing on the site may point at something that is not there.
    python3 tests/links/run
    # The work is published under the owner's name.
    python3 tests/attribution/run
    # Every glyph the site renders is in the face that ships with it.
    python3 tests/font/run
    # The one stylesheet rule you need a browser to see going wrong.
    python3 tests/css/run
    # A release is published with whatever `scripts/notes` returns.
    python3 tests/notes/run
    ;;
  build)
    cargo build --workspace
    ;;
  workflow:check)
    python3 tests/workflow/run
    ;;
  graph:check)
    node --test tests/necropolis/graph.mjs
    ;;
  browser:check)
    node tests/necropolis/browser.mjs
    ;;
  fuzz)
    # The soak. The short pass runs in `test` on every commit; this is the one
    # you leave going. NETHER_FUZZ_ROUNDS sets the length.
    cargo test --release --workspace --test fuzz --test monotone -- --ignored --nocapture
    ;;
  proofs)
    # The size demonstrations. Not part of `check`: they are evidence for a
    # roadmap item rather than a gate. `check` still compiles them, so they
    # cannot rot unnoticed, and cargo test runs the ones that are cheap.
    cargo test --release --workspace --test proofs -- --ignored --nocapture
    ;;
  site)
    # The site is baked from spec/ and committed. No node, no lockfile,
    # nothing to install.
    python3 site/bake
    ;;
  site:check)
    python3 site/bake --check
    ;;
  gfx)
    # Every graphic on the site is drawn by site/gfx.py, which contains a
    # GIF89a encoder and a bitmap font. There is no image library here.
    python3 site/gfx.py
    ;;
  gfx:check)
    python3 site/gfx.py --check
    ;;
  design)
    # Colour, space and type, generated into site/tokens.css.
    python3 site/design.py --css
    ;;
  design:check)
    python3 site/design.py --css --check
    ;;
  font)
    # One font, drawn here. There is no font library in this repository for
    # the same reason there is no image library.
    python3 site/font.py
    ;;
  font:check)
    python3 site/font.py --check
    ;;
  decay)
    # The Decay Rule. The trusted core may only ever get smaller.
    exec "$root/scripts/decay"
    ;;
  serve)
    # A static file server, so the site can be looked at.
    #
    # Not a wrapper around anything the language does -- §8.0 is about `nether
    # run` and this runs nothing. It exists because a browser treats a
    # `file://` page as an opaque origin and refuses to load a font from one,
    # so the face this site is set in is invisible exactly where somebody is
    # most likely to open it, and `web/necropolis/` cannot load its module at
    # all. Rooted at the repository so both are reachable.
    port=${2:-8000}
    echo "  site        http://localhost:$port/site/"
    echo "  necropolis  http://localhost:$port/web/necropolis/"
    echo
    exec python3 -m http.server "$port" --bind 127.0.0.1
    ;;
  wasm)
    # The core, built for a browser, and copied to where the page loads it.
    "$root/scripts/wasm"
    node --test tests/necropolis/wasm.mjs
    ;;
  check)
    "$0" fmt:check
    "$0" lint
    "$0" test
    "$0" build
    "$0" site:check
    "$0" gfx:check
    "$0" design:check
    "$0" font:check
    "$0" wasm
    "$0" browser:check
    "$0" decay
    # Skipped when it is not installed, which is for a contributor who has
    # not got it rather than for CI. CI installs it and lets the install fail.
    if command -v cairn >/dev/null 2>&1; then cairn check; fi
    ;;
  release)
    # Cut a release: check everything, then tag. The tag is the trigger --
    # `.github/workflows/release.yml` does the building and the publishing, so
    # this makes sure the thing being tagged deserves it.
    version="${2:-}"
    [ -n "$version" ] || { echo "usage: scripts/task release vX.Y.Z" >&2; exit 2; }
    case "$version" in
      v*) : ;;
      *) echo "release: the tag starts with v, as in v${version}" >&2; exit 2 ;;
    esac

    branch=$(git rev-parse --abbrev-ref HEAD)
    [ "$branch" = "main" ] || { echo "release: a release is cut from main, not $branch" >&2; exit 1; }
    [ -z "$(git status --porcelain)" ] || { echo "release: the tree is dirty" >&2; exit 1; }
    git fetch --quiet origin main
    [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || {
      echo "release: main is not what origin has" >&2; exit 1; }
    git rev-parse -q --verify "refs/tags/$version" >/dev/null && {
      echo "release: $version is already a tag, and a tag is a name" >&2; exit 1; }

    # The notes have to exist before the tag does. Finding out afterwards
    # means a published release nobody described.
    scripts/notes "$version" > /dev/null

    "$0" check

    git tag -a "$version" -m "$version"
    git push origin "$version"
    echo "tagged $version and pushed it; the Release workflow takes it from here"
    ;;

  *)
    echo "usage: scripts/task {fmt|fmt:check|lint|test|workflow:check|graph:check|browser:check|build|proofs|fuzz|site|site:check|gfx|gfx:check|design|design:check|font|font:check|wasm|serve|decay|check|release}" >&2
    exit 2
    ;;
esac
