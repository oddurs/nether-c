#!/bin/sh
# The seam. CI, the git hooks and scripts/agent know only these verbs;
# everything stack-specific lives here and nowhere else.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

case "${1:-}" in
  fmt)
    cargo fmt --all
    ;;
  fmt:check)
    cargo fmt --all -- --check
    ;;
  lint)
    cargo clippy --workspace --all-targets -- -D warnings
    ;;
  test)
    cargo test --workspace
    # Every code sample in the documentation is a fixture. Documentation that
    # lies fails the build.
    python3 tests/transcripts/run
    # The Decay Rule is only worth having if it actually fails.
    python3 tests/decay/run
    # The complemented VGA palette clears WCAG AA on both grounds, or it changes.
    python3 tests/contrast/run
    # Nothing on the site may point at something that is not there.
    python3 tests/links/run
    ;;
  build)
    cargo build --workspace
    ;;
  fuzz)
    # The soak. The short pass runs in `test` on every commit; this is the one
    # you leave going. NETHER_FUZZ_ROUNDS sets the length.
    cargo test --release --workspace --test fuzz --test monotone -- --ignored --nocapture
    ;;
  proofs)
    # The size demonstrations. Not part of `check`: they are evidence for a
    # roadmap item rather than a gate. `check` still compiles them, so they
    # cannot rot unnoticed, and cargo test runs the ones that are cheap.
    cargo test --release --workspace --test proofs -- --ignored --nocapture
    ;;
  site)
    # The site is baked from spec/ and committed. No node, no lockfile,
    # nothing to install.
    python3 site/bake
    ;;
  site:check)
    python3 site/bake --check
    ;;
  gfx)
    # Every graphic on the site is drawn by site/gfx.py, which contains a
    # GIF89a encoder and a bitmap font. There is no image library here.
    python3 site/gfx.py
    ;;
  gfx:check)
    python3 site/gfx.py --check
    ;;
  decay)
    # The Decay Rule. The trusted core may only ever get smaller.
    exec "$root/scripts/decay"
    ;;
  check)
    "$0" fmt:check
    "$0" lint
    "$0" test
    "$0" build
    "$0" site:check
    "$0" gfx:check
    "$0" decay
    if command -v cairn >/dev/null 2>&1; then cairn check; fi
    ;;
  *)
    echo "usage: scripts/task {fmt|fmt:check|lint|test|build|proofs|fuzz|site|site:check|gfx|gfx:check|decay|check}" >&2
    exit 2
    ;;
esac
