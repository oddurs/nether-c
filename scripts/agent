#!/bin/sh
# One unit of work, one worktree, one branch, one pull request.
#
# Two agents never share a checkout, and main only ever advances through a
# merged PR. This script is the only supported way to move work through the
# repository; everything it does is idempotent and says what it is doing.
set -eu

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "agent: not inside a git repository" >&2; exit 1; }

# Inside a worktree, --show-toplevel is the worktree, not the checkout the
# worktrees hang off. Everything that manages worktrees has to use the primary
# checkout instead, or `done` ends up cd-ing into the directory it removes.
common=$(git rev-parse --git-common-dir)
case "$common" in /*) ;; *) common="$(pwd)/$common" ;; esac
primary=$(cd "$(dirname "$common")" && pwd)

repo=$(basename "$primary")
trees=$(cd "$primary/.." && pwd)/.worktrees/$repo

default_branch() {
  if ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s\n' "${ref#origin/}"
  else
    echo main
  fi
}

die() { echo "agent: $*" >&2; exit 1; }
say() { printf '\033[2m→\033[0m %s\n' "$*"; }

cmd_guard() {
  branch=$(git symbolic-ref --quiet --short HEAD) || die "detached HEAD; use a feature worktree"
  [ "$branch" != "$(default_branch)" ] || die "no commits or branch pushes on $(default_branch); start a worktree"
  [ "$root" != "$primary" ] || die "the primary checkout is not a workspace; use scripts/agent start"
}

cmd_clean() {
  [ -z "$(git status --porcelain --untracked-files=all)" ] || {
    git status --short
    die "uncommitted work; commit it or preserve it before continuing"
  }
}

cmd_policy() { python3 "$root/scripts/pr-policy"; }

# ── doctor ───────────────────────────────────────────────────────────────────
cmd_doctor() {
  problems=0
  check() { # label command...
    label=$1; shift
    if "$@" >/dev/null 2>&1; then printf '  \033[32mok\033[0m    %s\n' "$label"
    else printf '  \033[31mfail\033[0m  %s\n' "$label"; problems=$((problems+1)); fi
  }
  echo "agent doctor — $repo"
  check "git present"            command -v git
  check "gh present"             command -v gh
  check "gh authenticated"       gh auth status
  check "cargo present"          command -v cargo
  check "python3 present"        command -v python3
  check "cairn present"          command -v cairn
  check "origin configured"      git remote get-url origin

  hooks=$(git config --get core.hooksPath 2>/dev/null || echo "")
  if [ "$hooks" = ".githooks" ]; then printf '  \033[32mok\033[0m    hooks path\n'
  else
    printf '  \033[33mfix\033[0m   hooks path was "%s"; setting it\n' "$hooks"
    git config core.hooksPath .githooks
  fi

  if git diff --quiet && git diff --cached --quiet; then
    printf '  \033[32mok\033[0m    working tree clean\n'
  else
    printf '  \033[33mwarn\033[0m  working tree dirty\n'
  fi

  if [ -d "$trees" ]; then
    printf '  \033[32mok\033[0m    worktree root %s\n' "$trees"
  else
    printf '  \033[2m--\033[0m    worktree root will be created at %s\n' "$trees"
  fi

  [ "$problems" -eq 0 ] || die "$problems problem(s) above"
  echo "clean."
}

# ── start ────────────────────────────────────────────────────────────────────
cmd_start() {
  branch=${1:-}
  [ -n "$branch" ] || die "usage: scripts/agent start <type>/<slug>"
  echo "$branch" | grep -qE '^(feat|fix|chore|docs|spec|perf|refactor|test)/[a-z0-9][a-z0-9._-]*$' \
    || die "branch must be <type>/<slug>, type one of feat fix chore docs spec perf refactor test"

  base=$(default_branch)
  git show-ref --verify --quiet "refs/heads/$branch" && die "branch $branch already exists"
  dest=$trees/$branch
  [ -e "$dest" ] && die "worktree already exists at $dest"

  say "fetching origin"
  git fetch --quiet origin
  say "creating $branch from origin/$base"
  mkdir -p "$(dirname "$dest")"
  git worktree add -b "$branch" "$dest" "origin/$base" >/dev/null
  ( cd "$dest" && git config core.hooksPath .githooks )

  printf '\nworktree ready. move into it:\n\n  cd %s\n\n' "$dest"
}

# ── the rest ─────────────────────────────────────────────────────────────────
cmd_check() { exec "$root/scripts/task" check; }

cmd_commit() {
  cmd_guard
  msg=${1:-}
  [ -n "$msg" ] || die "usage: scripts/agent commit \"type(scope): subject\""
  git commit -m "$msg"
}

cmd_pr() {
  case "${1:-}" in ''|--draft) ;; *) die "usage: scripts/agent pr [--draft]" ;; esac
  cmd_guard
  cmd_clean
  base=$(default_branch)
  branch=$(git rev-parse --abbrev-ref HEAD)
  head=$(git rev-parse HEAD)
  [ "$(git config --get core.hooksPath)" = .githooks ] || die "install hooks with scripts/setup"
  cmd_policy
  # An API failure must not look like an absent PR. Retrying reuses an open PR;
  # a branch whose earlier PR is closed or merged starts a new unit of work.
  existing=$(gh pr list --head "$branch" --base "$base" --state all --json number,state,isDraft \
    --jq '.[0] | if . == null then "" else "\(.number) \(.state) \(.isDraft)" end')
  case "$existing" in
    *' CLOSED '*|*' MERGED '*) die "this branch already has a finished PR; start a new worktree" ;;
  esac
  if [ "${1:-}" = --draft ]; then
    case "$existing" in *' false') die "existing PR is ready; --draft will not silently change it" ;; esac
  fi
  # pre-push is the one local full gate. Do not run it a second time here.
  say "pushing $branch"
  git push -u origin "$branch"
  # `--fill-first`, not `--fill`. With one commit they agree; with more than
  # one, `--fill` titles the pull request after the *branch* — and a squash
  # merge takes its subject from the title, so what lands on `main` is
  # `fix/0164-the-attribution-ban` rather than a Conventional Commit. The
  # commit-msg hook never sees it, because the server does the squash.
  if [ -z "$existing" ]; then
    say "opening pull request"
    if [ "${1:-}" = --draft ]; then
      gh pr create --fill-first --draft --base "$base" --head "$branch"
    else
      gh pr create --fill-first --base "$base" --head "$branch"
    fi
  elif [ "${1:-}" != --draft ]; then
    case "$existing" in *' true') gh pr ready "$branch" ;; esac
  fi
  if [ "${1:-}" != --draft ]; then
    # Arm auto-merge: the server lands it the moment `required` goes green, and
    # deletes the branch. Waiting for somebody to press the button means the
    # merge happens when a human next looks rather than when the work is ready.
    #
    # The safety is in the branch protection, not here. `main` requires
    # `required` to pass and a branch to be up to date with it, refuses force
    # pushes, deletions and merge commits, and enforces all of that on admins.
    # A pull request that arms this and then fails simply sits there.
    #
    # `--draft` is how to say not yet.
    say "arming auto-merge"
    gh pr merge "$branch" --auto --squash --match-head-commit "$head"
    say "armed: use scripts/agent wait to confirm the merge"
  fi
  gh pr view --json url --jq .url
}

cmd_wait() {
  cmd_guard
  cmd_clean
  branch=$(git symbolic-ref --short HEAD)
  head=$(git rev-parse HEAD)
  state=$(gh pr view "$branch" --json state,headRefOid,isDraft --jq '[.state,.headRefOid,.isDraft] | @tsv')
  [ "$state" = "$(printf 'MERGED\t%s\tfalse' "$head")" ] && { say "merged $head"; return; }
  [ "$state" = "$(printf 'OPEN\t%s\tfalse' "$head")" ] || die "PR is not ready at local HEAD: $state"
  gh pr checks "$branch" --watch --fail-fast --interval 10
  # Green checks and a merged PR are different facts. Give the server time to
  # apply auto-merge, but never claim completion just because checks passed.
  attempt=0
  while [ "$attempt" -lt 24 ]; do
    state=$(gh pr view "$branch" --json state,headRefOid --jq '[.state,.headRefOid] | @tsv')
    [ "$state" = "$(printf 'MERGED\t%s' "$head")" ] && { say "merged $head"; return; }
    [ "$state" = "$(printf 'OPEN\t%s' "$head")" ] || die "PR changed while waiting: $state"
    sleep 5
    attempt=$((attempt + 1))
  done
  die "checks passed but PR is not merged; inspect gh pr view before cleanup"
}

cmd_sync() {
  cmd_guard
  cmd_clean
  base=$(default_branch)
  say "fetching origin"
  git fetch --quiet origin
  say "rebasing onto origin/$base"
  git rebase "origin/$base"
}

cmd_done() {
  cmd_guard
  cmd_clean
  [ ! -e "$root/.nether" ] || die "this worktree holds a ledger; preserve .nether before cleanup"
  branch=$(git rev-parse --abbrev-ref HEAD)
  base=$(default_branch)
  [ "$branch" = "$base" ] && die "nothing to finish: already on $base"

  head=$(git rev-parse HEAD)
  state=$(gh pr view "$branch" --json state,headRefOid --jq '[.state,.headRefOid] | @tsv')
  [ "$state" = "$(printf 'MERGED\t%s' "$head")" ] || die "local HEAD is not the merged PR head: $state"

  dest=$(git rev-parse --show-toplevel)
  say "leaving $dest"

  # Retreat to the primary checkout BEFORE removing the worktree. Removing the
  # directory the shell is standing in leaves it with no working directory, and
  # every git command after it fails with "Unable to read current working
  # directory" -- including the branch delete and the prune, silently.
  cd "$primary"
  git worktree remove "$dest"
  # Compare-and-delete only the exact head proved merged above. Never delete
  # a branch advanced by another process between verification and cleanup.
  git update-ref -d "refs/heads/$branch" "$head"
  git worktree prune
  git fetch --prune --quiet origin
  if [ -z "$(git status --porcelain --untracked-files=all)" ] \
    && [ "$(git symbolic-ref --quiet --short HEAD)" = "$base" ]; then
    git merge --ff-only --quiet "origin/$base"
  else
    say "primary checkout left untouched: it is dirty or not on $base"
  fi

  printf '\nsurfaced. %s is gone.\n\n  cd %s\n\n' "$branch" "$primary"
}

cmd_list() {
  git worktree list --porcelain | awk '/^worktree /{w=$2} /^branch /{sub("refs/heads/","",$2); print $2"\t"w}' \
  | while IFS="$(printf '\t')" read -r b w; do
      st=$(gh pr view "$b" --json state --jq .state 2>/dev/null || echo "-")
      printf '  %-34s %-10s %s\n' "$b" "$st" "$w"
    done
}

case "${1:-}" in
  guard)             cmd_guard ;;
  clean)             cmd_clean ;;
  default-branch)    default_branch ;;
  policy)            cmd_policy ;;
  doctor)            shift; cmd_doctor "$@" ;;
  start|descend)     shift; cmd_start  "$@" ;;
  check)             shift; cmd_check  "$@" ;;
  commit)            shift; cmd_commit "$@" ;;
  pr)                shift; cmd_pr     "$@" ;;
  wait)              shift; cmd_wait   "$@" ;;
  sync)              shift; cmd_sync   "$@" ;;
  done|surface)      shift; cmd_done   "$@" ;;
  list|strata)       shift; cmd_list   "$@" ;;
  *)
    cat >&2 <<'USAGE'
usage: scripts/agent <command>

  doctor                    check the environment, fix what it safely can
  start <type>/<slug>       new branch + worktree, from origin/main   [descend]
  check                     scripts/task check
  commit "type: subject"    commit, conventionally
  policy                    audit live GitHub merge protection (read-only)
  pr [--draft]              check once, push, create/reuse PR, arm auto-merge
  wait                      wait for checks and verify this HEAD merged
  sync                      rebase onto origin/main
  done                      confirm merged, remove worktree and branch [surface]
  list                      worktrees, branches, PR state              [strata]

Branch types: feat fix chore docs spec perf refactor test
USAGE
    exit 2 ;;
esac
