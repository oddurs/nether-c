#!/usr/bin/env python3
"""The release notes for one version, cut out of CHANGELOG.md.

A release describes itself with the words somebody wrote for it, not with a
list of commit subjects. `CHANGELOG.md` is already in Keep a Changelog format,
which is a section per version, so the notes are already written -- this finds
the right one and refuses if it is not there.

    scripts/notes v0.1.0

Refusing is the point. A tag with no section in the changelog is a release
nobody described, and it is better to find that out before it is published
than after.
"""

import re
import sys
from pathlib import Path

CHANGELOG = Path(__file__).resolve().parents[1] / "CHANGELOG.md"


def _fence_open(stripped: str) -> tuple[str, int] | None:
    for ch in ("`", "~"):
        if stripped.startswith(ch * 3):
            n = len(stripped) - len(stripped.lstrip(ch))
            rest = stripped[n:]
            # CommonMark: backtick fence info strings may not contain backticks.
            if ch == "`" and "`" in rest:
                return None
            return (ch, n)
    return None


def _fence_close(stripped: str, fence: tuple[str, int]) -> bool:
    ch, n = fence
    if not stripped.startswith(ch * n):
        return False
    return stripped.lstrip(ch).strip() == ""


def notes(text: str, version: str) -> str | None:
    """Everything under `## [version]`, up to the next `## ` outside code fences."""
    want = version.removeprefix("v")
    # `## [1.2.3] - 2027-01-01` and `## [1.2.3]` both count, and nothing else
    # does: `## [Unreleased]` is not a release and must not be published as one.
    head = re.compile(r"^##\s+\[" + re.escape(want) + r"\](?:\s|$)")
    fence: tuple[str, int] | None = None
    capturing = False
    out: list[str] = []
    for line in text.splitlines(keepends=True):
        stripped = line.lstrip()
        if fence is not None:
            if _fence_close(stripped, fence):
                fence = None
            if capturing:
                out.append(line)
            continue
        opened = _fence_open(stripped)
        if opened is not None:
            fence = opened
            if capturing:
                out.append(line)
            continue
        if not capturing:
            if head.match(line):
                capturing = True
            continue
        if re.match(r"^##\s", line):
            break
        out.append(line)
    if not capturing:
        return None
    return "".join(out).strip()


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: scripts/notes <version>", file=sys.stderr)
        return 2
    version = argv[1]
    bare = version.removeprefix("v")
    if bare.lower() == "unreleased":
        print("notes: `Unreleased` is not a version", file=sys.stderr)
        return 1

    try:
        changelog = CHANGELOG.read_text(encoding="utf-8")
    except OSError as error:
        print(f"notes: cannot read {CHANGELOG}: {error}", file=sys.stderr)
        return 1

    body = notes(changelog, version)
    if body is None:
        print(f"notes: CHANGELOG.md has no section for {version}", file=sys.stderr)
        print(f"\n  add `## [{bare}] - YYYY-MM-DD` and say what changed",
              file=sys.stderr)
        return 1
    if not body:
        print(f"notes: the section for {version} is empty", file=sys.stderr)
        return 1

    print(body)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
