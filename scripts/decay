#!/usr/bin/env python3
"""The Decay Rule.

The trusted core may only ever get SMALLER. Below, things only decay.

The trusted core is the Rust that every guarantee rests on. Lowering the
ceiling in .decay-ceiling is an ordinary commit. Raising it is a deliberate
act that must be argued for in the pull request.

  scripts/decay [SOURCE_DIR] [CEILING_FILE]

The arguments exist so the rule can be tested against a tree that is not the
repository's own. They default to what you would expect.
"""

from __future__ import annotations

from dataclasses import dataclass, field
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CFG_TEST = re.compile(r"#\[\s*cfg\s*\(\s*test\s*\)\s*\]")


def _raw_string_start(raw: str, i: int) -> tuple[int, int] | None:
    """If `raw[i:]` starts a Rust raw string (`r"..."`, `br#"..."#`, `cr#"..."#`),
    return `(hash_count, body_start_index)`."""
    n = len(raw)
    if raw[i] == "r":
        j = i + 1
    elif raw[i] in ("b", "c") and i + 1 < n and raw[i + 1] == "r":
        j = i + 2
    else:
        return None
    if i > 0 and (raw[i - 1].isalnum() or raw[i - 1] == "_"):
        return None
    hashes = 0
    while j < n and raw[j] == "#":
        hashes += 1
        j += 1
    if j < n and raw[j] == '"':
        return hashes, j + 1
    return None


def _char_literal_end(raw: str, i: int) -> int | None:
    """If `raw[i:]` starts a Rust char literal (rather than a lifetime `'a`),
    return the index immediately after its closing quote."""
    n = len(raw)
    # An escaped char literal starts with `'\` followed by at least one escaped
    # character (e.g. `'\\'`, `'\''`, `'\n'`, `'\x7f'`, `'\u{...}'`), so scan
    # for the closing `'` starting at `i + 3`.
    if i + 2 < n and raw[i + 1] == "\\":
        j = i + 3
        while j < n and raw[j] != "'":
            j += 1
        return j + 1 if j < n else n
    if i + 2 < n and raw[i + 2] == "'":
        return i + 3
    return None


def scan_rust(text: str) -> list[tuple[str, str]]:
    """Return `(raw_line, code_tokens_only)` for each line of Rust source.

    Strips line comments, nested block comments, normal/byte/c strings,
    raw strings, and char literals without misclassifying Rust lifetimes (`'a`).
    """
    lines = text.splitlines()
    out: list[tuple[str, str]] = []
    block_depth = 0
    in_string = False
    raw_hashes: int | None = None

    for raw in lines:
        buf: list[str] = []
        i, n = 0, len(raw)
        if (in_string or raw_hashes is not None) and raw.strip():
            buf.append("_")
        while i < n:
            if block_depth > 0:
                if raw[i : i + 2] == "/*":
                    block_depth += 1
                    i += 2
                elif raw[i : i + 2] == "*/":
                    block_depth -= 1
                    i += 2
                else:
                    i += 1
                continue

            if raw_hashes is not None:
                if raw[i] == '"' and raw[i + 1 : i + 1 + raw_hashes] == "#" * raw_hashes:
                    i += 1 + raw_hashes
                    raw_hashes = None
                else:
                    i += 1
                continue

            if in_string:
                if raw[i] == "\\":
                    i += 2
                elif raw[i] == '"':
                    in_string = False
                    i += 1
                else:
                    i += 1
                continue

            two = raw[i : i + 2]
            if two == "//":
                break
            if two == "/*":
                block_depth = 1
                i += 2
                continue

            raw_start = _raw_string_start(raw, i)
            if raw_start is not None:
                buf.append("_")
                raw_hashes, i = raw_start
                continue

            if raw[i] == '"':
                buf.append("_")
                in_string = True
                i += 1
                continue

            if raw[i] == "'":
                end = _char_literal_end(raw, i)
                if end is not None:
                    buf.append("_")
                    i = end
                else:
                    buf.append("'")
                    i += 1
                continue

            buf.append(raw[i])
            i += 1

        out.append((raw, "".join(buf)))
    return out


_ITEM_HEAD = re.compile(r"\b(use|static|type|const|fn|mod|struct|enum|union|trait|impl|extern|macro_rules)\b")


@dataclass
class _SkipState:
    """Tracks the item attached to a `#[cfg(test)]` attribute until its terminator."""

    pending: bool = True
    semi_item: bool = False
    saw_const: bool = False
    seen_eq: bool = False
    head_tokens: list[str] = field(default_factory=list)
    depth: int = 0
    bracket_depth: int = 0
    angle_depth: int = 0
    angle_brace_depth: int = 0

    def classify_head(self, bare: str, pos: int) -> tuple[int, bool]:
        """Identify whether the skipped item terminates at `;` or a matching `}`."""
        if not (
            self.pending
            and self.depth == 0
            and self.bracket_depth == 0
            and self.angle_depth == 0
            and not self.semi_item
            and not self.head_tokens
        ):
            return pos, False

        n = len(bare)
        if bare[pos].isspace():
            return pos + 1, True
        if bare[pos : pos + 2] == "#[":
            self.bracket_depth = 1
            return pos + 2, True
        if bare[pos].isalpha() or bare[pos] == "_":
            j = pos
            while j < n and (bare[j].isalnum() or bare[j] == "_"):
                j += 1
            word = bare[pos:j]
            if self.saw_const:
                self.saw_const = False
                if word in ("fn", "unsafe"):
                    self.head_tokens.append("fn")
                else:
                    self.semi_item = True
                    self.head_tokens.append("const")
                return j, True
            if word in ("pub", "unsafe", "async", "default"):
                return j, True
            if word in ("use", "static", "type", "let"):
                self.semi_item = True
                self.head_tokens.append(word)
                return j, True
            if word in ("if", "match", "while", "for", "loop"):
                self.seen_eq = True
                self.head_tokens.append(word)
                return j, True
            if word == "const":
                self.saw_const = True
                return j, True
            if _ITEM_HEAD.fullmatch(word):
                self.head_tokens.append(word)
                return j, True
            return j, j == n
        if self.saw_const:
            self.saw_const = False
            self.semi_item = True
            self.head_tokens.append("const")
        return pos, False

    def step_char(self, bare: str, pos: int) -> bool:
        """Advance over `bare[pos]`; return True when the skipped item ends."""
        ch = bare[pos]
        if ch in "([":
            self.bracket_depth += 1
        elif ch in ")]" and self.bracket_depth > 0:
            self.bracket_depth -= 1
        elif self.angle_depth > 0 and self.bracket_depth == 0:
            if ch == "{":
                self.angle_brace_depth += 1
            elif ch == "}" and self.angle_brace_depth > 0:
                self.angle_brace_depth -= 1
            elif self.angle_brace_depth == 0:
                if ch == "<":
                    self.angle_depth += 1
                elif ch == ">" and (pos == 0 or bare[pos - 1] != "-"):
                    self.angle_depth -= 1
        elif self.semi_item and self.depth == 0 and self.bracket_depth == 0 and ch == "=":
            self.seen_eq = True
        elif self.pending and self.bracket_depth == 0 and not self.seen_eq and ch == "<":
            self.angle_depth += 1
            self.angle_brace_depth = 0
        elif ch == "{" and self.bracket_depth == 0:
            if not self.semi_item:
                self.pending = False
            self.depth += 1
        elif ch == "}" and self.bracket_depth == 0:
            self.depth -= 1
            if self.depth <= 0 and not self.pending and not self.semi_item:
                return True
        elif ch == ";" and self.depth == 0 and self.bracket_depth == 0 and (self.pending or self.semi_item):
            return True
        return False


def core_lines(path: Path) -> int:
    """Count core lines in one Rust file, excluding `#[cfg(test)]` items."""
    text = path.read_text(encoding="utf-8")
    skip: _SkipState | None = None
    count = 0

    for _raw, bare in scan_rust(text):
        pos = 0
        n = len(bare)
        has_core = False

        while pos < n:
            if skip is None:
                m = CFG_TEST.search(bare, pos)
                if m is None:
                    if bare[pos:].strip():
                        has_core = True
                    break
                if bare[pos : m.start()].strip():
                    has_core = True
                skip = _SkipState()
                pos = m.end()
                continue

            pos, consumed = skip.classify_head(bare, pos)
            if consumed:
                continue
            if skip.step_char(bare, pos):
                skip = None
            pos += 1

        if has_core:
            count += 1
    return count


def main(argv: list[str]) -> int:
    init = "--init" in argv[1:]
    pos = [a for a in argv[1:] if a != "--init"]
    source_dir = Path(pos[0]) if len(pos) > 0 else ROOT / "crates"
    ceiling_file = Path(pos[1]) if len(pos) > 1 else ROOT / ".decay-ceiling"
    custom_ceiling = len(pos) > 1
    if not source_dir.is_absolute():
        source_dir = ROOT / source_dir
    if not ceiling_file.is_absolute():
        ceiling_file = ROOT / ceiling_file

    if not source_dir.is_dir():
        print(f"decay: source directory does not exist: {source_dir}", file=sys.stderr)
        return 1

    def is_excluded(rel: Path) -> bool:
        parts = rel.parts
        if not parts:
            return False
        if parts[0] in ("target", "tests", "benches"):
            return True
        if parts[0] == "src":
            return False
        return len(parts) >= 2 and parts[1] in ("target", "tests", "benches")

    rs_files = sorted(
        p for p in source_dir.rglob("*.rs")
        if not is_excluded(p.relative_to(source_dir))
    )
    if not rs_files:
        print(f"decay: no Rust source files found under {source_dir}", file=sys.stderr)
        return 1

    count = sum(core_lines(p) for p in rs_files)

    if not ceiling_file.is_file():
        if not custom_ceiling and not init:
            print(f"decay: {ceiling_file} is missing; refusing to bypass the ceiling.", file=sys.stderr)
            print(f"       The core is {count} lines. Restore .decay-ceiling or run with --init.", file=sys.stderr)
            return 1
        ceiling_file.write_text(f"{count}\n", encoding="utf-8")
        print(f"decay: no ceiling found; sealed the current core at {count} lines")
        return 0

    raw_ceiling = ceiling_file.read_text(encoding="utf-8").strip()
    if not re.fullmatch(r"[0-9]+", raw_ceiling):
        print(f"decay: {ceiling_file} holds no valid number, so there is no ceiling.", file=sys.stderr)
        print(f"       The core is {count} lines. Write that, or write the number you meant.", file=sys.stderr)
        return 1

    ceiling = int(raw_ceiling)
    label = pos[1] if custom_ceiling else ".decay-ceiling"
    if count > ceiling:
        print("decay: the trusted core grew.", file=sys.stderr)
        print(f"       ceiling  {ceiling} lines  ({label})", file=sys.stderr)
        print(f"       now      {count} lines", file=sys.stderr)
        print("", file=sys.stderr)
        print(f"  Below, things only decay. Either take {count - ceiling} lines back", file=sys.stderr)
        print("  out, or raise the ceiling deliberately and say why in the PR body.", file=sys.stderr)
        return 1

    if count < ceiling:
        print(f"decay: core is {ceiling - count} lines below the ceiling ({count}/{ceiling})")
        print(f"       lower it:  echo {count} > {label}")
    else:
        print(f"decay: core at the ceiling ({count} lines)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
