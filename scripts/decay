#!/bin/sh
# The Decay Rule.
#
# TempleOS was fixed at a size given by covenant and never grew. Nether C
# inverts that: the trusted core may only ever get SMALLER. Below, things
# only decay.
#
# The trusted core is the Rust that every guarantee rests on. Lowering the
# ceiling in .decay-ceiling is an ordinary commit. Raising it is a deliberate
# act that must be argued for in the pull request.
#
#   scripts/decay [SOURCE_DIR] [CEILING_FILE]
#
# The arguments exist so the rule can be tested against a tree that is not the
# repository's own. They default to what you would expect.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

source_dir=${1:-crates}
ceiling_file=${2:-.decay-ceiling}

# What counts is the trusted core: the code every guarantee rests on. Tests are
# not that. They are what makes it trustworthy, and a rule that makes you
# delete tests in order to add a feature is pointing the wrong way.
#
# A `#[cfg(test)]` item is excluded wherever it is, by matching its braces,
# rather than by deleting from the first marker to the end of the file. That
# shorter rule assumed the trailing-module convention and nothing enforced it,
# so one attribute at the top of a file removed the file from the count.
#
# Integration tests and benches live beside the code they exercise and are no
# more the trusted core than a `#[cfg(test)]` module is.
core_lines() {
  awk '
    # Strip what a brace could hide in: block comments, line comments, string
    # and character literals. Nothing here needs the text, only the braces.
    function clean(s,   out, i, c, n) {
      out = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (block) { if (c == "*" && substr(s, i + 1, 1) == "/") { block = 0; i++ } ; continue }
        if (c == "/" && substr(s, i + 1, 1) == "*") { block = 1; i++; continue }
        if (c == "/" && substr(s, i + 1, 1) == "/") { break }
        if (c == "\"") { i = skip_quote(s, i, "\""); continue }
        if (c == "'"'"'") { i = skip_quote(s, i, "'"'"'"); continue }
        out = out c
      }
      return out
    }
    function skip_quote(s, i, q,   n, c) {
      n = length(s); i++
      while (i <= n) {
        c = substr(s, i, 1)
        if (c == "\\") { i += 2; continue }
        if (c == q) { return i }
        i++
      }
      return n
    }
    BEGIN { block = 0 }
    {
      bare = clean($0)
      if (!skip && bare ~ /#\[cfg\(test\)\]/) { skip = 1; pending = 1; depth = 0 }
      if (skip) {
        for (i = 1; i <= length(bare); i++) {
          c = substr(bare, i, 1)
          if (c == "{") { pending = 0; depth++ }
          else if (c == "}") { depth--; if (depth <= 0 && !pending) { skip = 0; break } }
          # An attribute on something with no block at all: `#[cfg(test)] use x;`
          else if (c == ";" && pending && depth == 0) { skip = 0; break }
        }
        next
      }
      # A line is core if it holds anything but whitespace and a line comment.
      # The cleaned text is for finding braces, not for deciding this: a line
      # that is nothing but the middle of a string literal is still a line.
      if ($0 ~ /^[[:space:]]*(\/\/.*)?$/) next
      n++
    }
    END { print n + 0 }
  ' "$1"
}

count=$(find "$source_dir" -name '*.rs' \
    -not -path '*/target/*' \
    -not -path '*/tests/*' \
    -not -path '*/benches/*' 2>/dev/null \
  | while IFS= read -r file; do core_lines "$file"; done \
  | awk '{ n += $1 } END { print n + 0 }')

if [ ! -f "$ceiling_file" ]; then
  echo "$count" > "$ceiling_file"
  echo "decay: no ceiling found; sealed the current core at $count lines"
  exit 0
fi

ceiling=$(tr -dc '0-9' < "$ceiling_file")

if [ "$count" -gt "$ceiling" ]; then
  echo "decay: the trusted core grew." >&2
  echo "       ceiling  $ceiling lines  ($ceiling_file)" >&2
  echo "       now      $count lines" >&2
  echo "" >&2
  echo "  Below, things only decay. Either take $((count - ceiling)) lines back" >&2
  echo "  out, or raise the ceiling deliberately and say why in the PR body." >&2
  exit 1
fi

if [ "$count" -lt "$ceiling" ]; then
  echo "decay: core is $((ceiling - count)) lines below the ceiling ($count/$ceiling)"
  echo "       lower it:  echo $count > $ceiling_file"
else
  echo "decay: core at the ceiling ($count lines)"
fi
