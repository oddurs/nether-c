#!/bin/sh
# The Decay Rule.
#
# TempleOS was fixed at a size given by covenant and never grew. Nether C
# inverts that: the trusted core may only ever get SMALLER. Below, things
# only decay.
#
# The trusted core is the Rust that every guarantee rests on. Lowering the
# ceiling in .decay-ceiling is an ordinary commit. Raising it is a deliberate
# act that must be argued for in the pull request.
#
#   scripts/decay [SOURCE_DIR] [CEILING_FILE]
#
# The arguments exist so the rule can be tested against a tree that is not the
# repository's own. They default to what you would expect.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

source_dir=${1:-crates}
ceiling_file=${2:-.decay-ceiling}

# What counts is the trusted core: the code every guarantee rests on. Tests are
# not that. They are what makes it trustworthy, and a rule that makes you
# delete tests in order to add a feature is pointing the wrong way.
#
# By convention a file's tests live in a trailing `#[cfg(test)] mod tests`, so
# everything from the first such marker to the end of the file is excluded.
count=0
for file in $(find "$source_dir" -name '*.rs' -not -path '*/target/*' 2>/dev/null); do
  n=$(sed '/#\[cfg(test)\]/,$d' "$file" | grep -cvE '^[[:space:]]*(//.*)?$' || true)
  count=$((count + ${n:-0}))
done

if [ ! -f "$ceiling_file" ]; then
  echo "$count" > "$ceiling_file"
  echo "decay: no ceiling found; sealed the current core at $count lines"
  exit 0
fi

ceiling=$(tr -dc '0-9' < "$ceiling_file")

if [ "$count" -gt "$ceiling" ]; then
  echo "decay: the trusted core grew." >&2
  echo "       ceiling  $ceiling lines  ($ceiling_file)" >&2
  echo "       now      $count lines" >&2
  echo "" >&2
  echo "  Below, things only decay. Either take $((count - ceiling)) lines back" >&2
  echo "  out, or raise the ceiling deliberately and say why in the PR body." >&2
  exit 1
fi

if [ "$count" -lt "$ceiling" ]; then
  echo "decay: core is $((ceiling - count)) lines below the ceiling ($count/$ceiling)"
  echo "       lower it:  echo $count > $ceiling_file"
else
  echo "decay: core at the ceiling ($count lines)"
fi
