# ROADMAP.md is generated from the items. On a merge, re-derive it rather than
# trying to reconcile two renderings of different inputs.
ROADMAP.md merge=cairn

# An item is the source rather than a rendering, so it cannot be re-derived.
# The driver unions its sequence fields, where two branches both meant what
# they added, and leaves everything else to a person.
cairn/items/*.md merge=cairn

# Line endings, everywhere.
* text=auto eol=lf

# The site is generated by site/bake and committed deliberately. Collapse it in
# diffs so a spec change does not read as a thousand-line HTML change.
site/index.html      linguist-generated=true
site/spec/*.html     linguist-generated=true

# The specification is the point of the repository, not documentation about it.
spec/*.md            linguist-documentation=false
