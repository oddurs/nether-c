#!/usr/bin/env python3
"""
links — nothing on the published site may point at something that is not there.

The specification is a dozen cross-linked documents rendered into a dozen
cross-linked pages, and a link that 404s is invisible until somebody clicks it.
This resolves every internal href, src and fragment in the baked site.

The spec is also cited by number, as "§90.3", and a number that heads two
sections on one page is a reference with two targets. So a section number
heads exactly one section of its page.

`site/template.html` is skipped: it is the template, and its `{{UP}}` markers
are placeholders rather than paths.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path
from urllib.parse import unquote

ROOT = Path(__file__).resolve().parents[2]
SITE = ROOT / "site"

REF = re.compile(r'(?:href|src)="([^"]+)"')
ANCHOR = re.compile(r'\sid="([^"]+)"')
NUMBERED = re.compile(r'<h[1-6] id="[^"]*"><a [^>]*>(\d+(?:\.\d+)+)\s')


def pages() -> list[Path]:
    return sorted(p for p in SITE.rglob("*.html") if "src" not in p.parts and p.name != "template.html")


def main() -> int:
    anchors: dict[Path, set[str]] = {}
    for page in pages():
        anchors[page] = set(ANCHOR.findall(page.read_text(encoding="utf-8")))

    broken: list[str] = []
    internal = external = 0

    for page in pages():
        rel = page.relative_to(SITE)
        for raw in REF.findall(page.read_text(encoding="utf-8")):
            if raw.startswith(("http://", "https://", "mailto:", "data:")):
                external += 1
                continue
            internal += 1
            path, _, fragment = raw.partition("#")
            target = page if not path else (page.parent / unquote(path)).resolve()
            if not target.exists():
                broken.append(f"{rel} -> {raw}  (no such file)")
                continue
            if fragment and target.suffix == ".html":
                if fragment not in anchors.get(target, set()):
                    broken.append(f"{rel} -> {raw}  (no such anchor)")
        seen: set[str] = set()
        for number in NUMBERED.findall(page.read_text(encoding="utf-8")):
            if number in seen:
                broken.append(f"{rel}: §{number} heads two sections")
            seen.add(number)

    for b in broken:
        print(f"links: {b}", file=sys.stderr)

    print(f"links: {len(pages())} page(s), {internal} internal reference(s) resolved, {external} external not checked")
    if broken:
        print(f"links: {len(broken)} broken", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
