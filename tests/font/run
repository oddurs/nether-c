#!/usr/bin/env python3
"""Every glyph the site puts in front of a reader is in the face that ships.

The face is not a guess at what might be wanted. This reads the built site and
the specification, collects every codepoint that will actually be rendered, and
fails naming any the font does not have — so the day a transcript grows a new
arrow, the build says which glyph to draw rather than a reader finding a box.

It also reads the glyph back out of the font's own `cmap`, not out of
site/font.py, so a face that was built wrong fails here too.

Both weights, and the same checks on each, plus the ones that only mean
anything between two faces: the same coverage, the same advance, and an `OS/2`
that says which weight it is. A bold that is missing a glyph or a column wider
than the regular breaks a listing in a way no single-face check can see.
"""

import html
import re
import struct
import sys
import unicodedata
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
FACES = {
    "regular": (ROOT / "site" / "nether.woff", 400),
    "bold": (ROOT / "site" / "nether-bold.woff", 700),
}

# What the browser never asks the face for.
IGNORED = set("\n\r\t ﻿")


def rendered() -> set[str]:
    """Every character the pages and CSS-generated labels ask the face for."""
    seen: set[str] = set()
    for page in sorted(ROOT.glob("site/**/*.html")) + sorted(ROOT.glob("spec/*.md")):
        text = page.read_text(encoding="utf-8")
        if page.suffix == ".html":
            text = re.sub(r"<(script|style)\b.*?</\1>", " ", text, flags=re.S | re.I)
            text = html.unescape(re.sub(r"<[^>]+>", " ", text))
        seen |= set(text)
    for sheet in ROOT.glob("site/**/*.css"):
        # CSS consumes the following whitespace as part of a hexadecimal escape.
        # The heading prefixes are text just as surely as a letter in a page is.
        for code in re.findall(r"\\([0-9a-fA-F]{1,6})(?:\s)?", sheet.read_text(encoding="utf-8")):
            seen.add(chr(int(code, 16)))
    return seen - IGNORED


def tables(data: bytes) -> dict[bytes, bytes]:
    """Every table in the WOFF, uncompressed."""
    count = struct.unpack(">H", data[12:14])[0]
    out: dict[bytes, bytes] = {}
    for i in range(count):
        at = 44 + 20 * i
        tag, offset, comp, orig, _ = struct.unpack(">4sIIII", data[at:at + 20])
        raw = data[offset:offset + comp]
        out[tag] = raw if comp == orig else zlib.decompress(raw)
    return out


def cmap_of(table: bytes) -> set[int]:
    """The codepoints the shipped file actually maps, read out of the file."""
    (sub_offset,) = struct.unpack(">I", table[8:12])
    sub = table[sub_offset:]
    seg2 = struct.unpack(">H", sub[6:8])[0]
    n = seg2 // 2
    ends = struct.unpack(f">{n}H", sub[14:14 + seg2])
    starts = struct.unpack(f">{n}H", sub[16 + seg2:16 + 2 * seg2])
    deltas = struct.unpack(f">{n}h", sub[16 + 2 * seg2:16 + 3 * seg2])

    found: set[int] = set()
    for start, end, delta in zip(starts, ends, deltas):
        if start == 0xFFFF:
            continue
        for code in range(start, end + 1):
            if (code + delta) & 0xFFFF:
                found.add(code)
    return found


def main() -> int:
    sys.path.insert(0, str(ROOT / "site"))
    import font as source  # noqa: E402 — the thing under test, not a dependency

    drawings = {"regular": source.G, "bold": source.bold()}
    want = rendered()
    built: dict[str, dict[bytes, bytes]] = {}

    for weight, (path, expected) in FACES.items():
        if not path.exists():
            print(f"font: {path.relative_to(ROOT)} is not built; "
                  "run python3 site/font.py", file=sys.stderr)
            return 1
        shipped = built[weight] = tables(path.read_bytes())
        have = cmap_of(shipped[b"cmap"])
        missing = sorted(c for c in want if ord(c) not in have)
        if missing:
            print(f"font: the site renders glyphs the {weight} does not have:",
                  file=sys.stderr)
            for c in missing:
                print(f"  U+{ord(c):04X}  {c}  {unicodedata.name(c, '?')}", file=sys.stderr)
            print("\n  draw them in site/font.py, or take them out of the page",
                  file=sys.stderr)
            return 1
        loose = unmapped(shipped)
        if loose:
            print(f"font: the {weight} cmap maps characters to glyphs it does not have:",
                  file=sys.stderr)
            for code, gid, total in loose:
                print(f"  U+{code:04X} -> glyph {gid}, and there are {total}", file=sys.stderr)
            print("\n  a browser throws out the whole face for this, and says nothing",
                  file=sys.stderr)
            return 1
        wrong = outlines(shipped, have, drawings[weight])
        if wrong:
            print(f"font: the {weight} outlines do not decode back to what was drawn:",
                  file=sys.stderr)
            for code, why in wrong:
                print(f"  U+{code:04X}  {why}", file=sys.stderr)
            return 1
        bad_metrics = metrics(shipped, drawings[weight], expected)
        if bad_metrics:
            print(f"font: the {weight} is not a consistently spaced mono face:",
                  file=sys.stderr)
            for why in bad_metrics:
                print(f"  {why}", file=sys.stderr)
            return 1

    drawn = source.weigh()
    if drawn:
        print("font: the bold does not answer to the regular:", file=sys.stderr)
        for why in drawn:
            print(f"  {why}", file=sys.stderr)
        return 1

    apart = between(built["regular"], built["bold"])
    if apart:
        print("font: the two weights are not the same face:", file=sys.stderr)
        for why in apart:
            print(f"  {why}", file=sys.stderr)
        return 1

    have = cmap_of(built["regular"][b"cmap"])
    spare = len(have) - len(want)
    print(f"font: {len(want)} glyph(s) rendered, both weights have them, {spare} spare")
    print(f"font: {2 * len(have)} outline(s) decode to the pixels they were drawn from")
    print(f"font: {len(have) - len(source.SAME)} glyph(s) drawn twice, "
          f"{len(source.SAME)} the same at both weights")
    return 0


def between(regular: dict[bytes, bytes], bold: dict[bytes, bytes]) -> list[str]:
    """What only means anything with two faces in front of you.

    The advance is the one with teeth. The site is columns — listings,
    diagrams, the sign — and a bold that advances one unit further than its
    regular moves every one of them wherever a keyword or a depth is coloured.
    """
    bad = []
    if cmap_of(regular[b"cmap"]) != cmap_of(bold[b"cmap"]):
        bad.append("the two weights do not cover the same codepoints")
    advances = []
    for table in (regular, bold):
        (count,) = struct.unpack(">H", table[b"maxp"][4:6])
        advances.append([struct.unpack(">H", table[b"hmtx"][i * 4:i * 4 + 2])[0]
                         for i in range(count)])
    if advances[0] != advances[1]:
        bad.append("the two weights do not advance identically")
    if regular[b"hhea"] != bold[b"hhea"]:
        bad.append("the two weights do not agree on ascent, descent or advance")
    for name, table, weight, selection in (
        ("regular", regular, 400, 0b1000000), ("bold", bold, 700, 0b100000)
    ):
        (said,) = struct.unpack(">H", table[b"OS/2"][4:6])
        (flags,) = struct.unpack(">H", table[b"OS/2"][62:64])
        (style,) = struct.unpack(">H", table[b"head"][44:46])
        if said != weight:
            bad.append(f"the {name} says usWeightClass {said} and not {weight}")
        if flags != selection:
            bad.append(f"the {name} says fsSelection {flags:b} and not {selection:b}")
        if style != (1 if weight >= 700 else 0):
            bad.append(f"the {name} head.macStyle does not say what it is")
    return bad


def metrics(shipped: dict[bytes, bytes], drawn: dict[str, tuple[str, ...]],
            weight: int) -> list[str]:
    """The spacing contract is as real as the outlines.

    The drawing grid is eight pixels wide, while six pixels plus one blank
    bearing make its fixed advance. Every glyph must advance identically: pair
    kerning would make a listing lie about its columns. Reading hmtx back from
    the WOFF catches a writer change; reading G catches a future glyph that
    draws past its ink field.
    """
    sys.path.insert(0, str(ROOT / "site"))
    import font as source  # noqa: E402 — the thing under test, not a dependency

    bad = []
    if (source.INK_COLS, source.ADVANCE_COLS) != (6, 7):
        bad.append("the face must keep six ink columns and a seven-column mono advance")
    (count,) = struct.unpack(">H", shipped[b"maxp"][4:6])
    widths = [struct.unpack(">Hh", shipped[b"hmtx"][i * 4:i * 4 + 4])[0]
              for i in range(count)]
    if len(widths) != count or any(width != source.ADVANCE for width in widths):
        bad.append(f"hmtx does not give all {count} glyphs the {source.ADVANCE}-unit advance")
    (maximum,) = struct.unpack(">H", shipped[b"hhea"][10:12])
    if maximum != source.ADVANCE:
        bad.append(f"hhea says the maximum advance is {maximum}, not {source.ADVANCE}")
    (fixed,) = struct.unpack(">I", shipped[b"post"][12:16])
    if fixed != 1:
        bad.append("post does not mark the face fixed-pitch")
    for ch, rows in drawn.items():
        if any(bit == "#" for row in rows for bit in row[source.INK_COLS:]):
            bad.append(f"U+{ord(ch):04X} draws past the six-column mono cell")
    for gid, ch in enumerate(sorted(drawn), 1):
        columns = [x for row in drawn[ch] for x, bit in enumerate(row) if bit == "#"]
        expected = min(columns, default=0) * source.PIXEL
        (_, bearing) = struct.unpack(">Hh", shipped[b"hmtx"][gid * 4:gid * 4 + 4])
        if bearing != expected:
            bad.append(f"U+{ord(ch):04X} loses its drawn left bearing")
    if b"kern" in shipped or b"GPOS" in shipped:
        bad.append("pair positioning must not change fixed columns")
    sys.path.insert(0, str(ROOT / "site"))
    import gfx
    for ch, rows in gfx.FONT.items():
        if len(rows) != 7 or any(len(row) != 5 or set(row) - {".", "#"} for row in rows):
            bad.append(f"display {ch!r} escapes its five-by-seven drawing cell")
    return bad


def unmapped(shipped: dict[bytes, bytes]) -> list[tuple[int, int, int]]:
    """Characters the `cmap` sends to a glyph that is not there.

    A browser sanitises a face before it will use it, and a mapping that points
    past the end of the font fails that check -- the face is dropped whole and
    every page falls back to a system font, with nothing said anywhere. 0229
    was one field: the terminating segment mapped U+FFFF to glyph 65535 in a
    font with 137 glyphs, because its idDelta was 0 where it had to be 1.

    This walks the `cmap` the way the sanitiser does rather than trusting
    `site/font.py`, so it fails whatever writes the table wrong.
    """
    count = struct.unpack(">H", shipped[b"maxp"][4:6])[0]
    sub = shipped[b"cmap"][struct.unpack(">I", shipped[b"cmap"][8:12])[0]:]
    segs = struct.unpack(">H", sub[6:8])[0] // 2
    ends = struct.unpack(f">{segs}H", sub[14:14 + segs * 2])
    starts = struct.unpack(f">{segs}H", sub[16 + segs * 2:16 + segs * 4])
    deltas = struct.unpack(f">{segs}h", sub[16 + segs * 4:16 + segs * 6])

    bad = []
    for start, end, delta in zip(starts, ends, deltas):
        # Every segment here is a run, so its ends are the extremes.
        for code in {start, end}:
            gid = (code + delta) & 0xFFFF
            if gid >= count:
                bad.append((code, gid, count))
    return sorted(set(bad))


def points_of(glyph: bytes) -> list[tuple[int, int]] | str:
    """Decode one simple glyph, or say where the point stream ran out.

    The encoder writes a flag per point and the deltas in two streams after
    them, and the flag says how many bytes its delta takes. If the two ever
    disagree the stream desynchronises and every point after it is wrong --
    which is exactly what 0178 was, so this walks it byte by byte and refuses
    to guess.
    """
    if not glyph:
        return []
    (n,) = struct.unpack(">h", glyph[:2])
    if n < 0:
        return "composite glyphs are not written here"
    at = 10
    ends = struct.unpack(f">{n}H", glyph[at:at + 2 * n])
    at += 2 * n
    (instructions,) = struct.unpack(">H", glyph[at:at + 2])
    at += 2 + instructions

    total = ends[-1] + 1
    flags = glyph[at:at + total]
    if len(flags) != total:
        return f"{total} points but only {len(flags)} flag(s)"
    at += total

    coords: list[list[int]] = []
    for short, same in ((0x02, 0x10), (0x04, 0x20)):
        values = []
        value = 0
        for flag in flags:
            if flag & short:
                if at >= len(glyph):
                    return "the point stream ends inside a short delta"
                step = glyph[at]
                at += 1
                value += step if flag & same else -step
            elif flag & same:
                pass
            else:
                if at + 2 > len(glyph):
                    return "the point stream ends inside a long delta"
                (step,) = struct.unpack(">h", glyph[at:at + 2])
                at += 2
                value += step
            values.append(value)
        coords.append(values)

    # Up to three bytes of padding to the next four-byte boundary, and no more.
    if len(glyph) - at > 3:
        return f"{len(glyph) - at} bytes left over after the last point"
    return list(zip(coords[0], coords[1]))


def outlines(shipped: dict[bytes, bytes], have: set[int],
             drawn: dict[str, tuple[str, ...]]) -> list[tuple[int, str]]:
    """Every glyph, decoded and compared with the bitmap it was drawn from."""
    sys.path.insert(0, str(ROOT / "site"))
    import font as source  # noqa: E402 — the thing under test, not a dependency

    (fmt,) = struct.unpack(">h", shipped[b"head"][50:52])
    loca_raw = shipped[b"loca"]
    if fmt == 0:
        loca = [o * 2 for o in struct.unpack(f">{len(loca_raw) // 2}H", loca_raw)]
    else:
        loca = list(struct.unpack(f">{len(loca_raw) // 4}I", loca_raw))
    glyf = shipped[b"glyf"]

    wrong: list[tuple[int, str]] = []
    for i, code in enumerate(sorted(have)):
        gid = i + 1  # glyph 0 is .notdef
        got = points_of(glyf[loca[gid]:loca[gid + 1]])
        if isinstance(got, str):
            wrong.append((code, got))
            continue
        # What the bitmap says the corners should be, in the same order.
        want = []
        for r, first, last in source.runs(drawn[chr(code)]):
            x0, x1 = first * source.PIXEL, (last + 1) * source.PIXEL
            y0 = source.ASCENT - (r + 1) * source.PIXEL
            want += [(x0, y0), (x0, y0 + source.PIXEL),
                     (x1, y0 + source.PIXEL), (x1, y0)]
        if got != want:
            wrong.append((code, f"{len(got)} point(s) decoded, {len(want)} drawn"))
    return wrong


if __name__ == "__main__":
    raise SystemExit(main())
