#!/usr/bin/env python3
"""
decay — a test for the rule that the trusted core may only ever shrink.

The rule is only worth having if it actually fails, so this drives
scripts/decay against a tree it does not control and checks all four
behaviours: growth is refused, parity is accepted, shrinkage is reported with
the new number, and a missing ceiling seals itself.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
DECAY = ROOT / "scripts" / "decay"

BODY = """\
// a comment, which does not count

fn one() {}

fn two() {}
"""

# Tests are not the trusted core, so adding them must not move the number.
# The module holds a brace inside a string literal, because a counter that
# matches braces has to know the difference.
TESTS = """\
#[cfg(test)]
mod tests {
    #[test]
    fn a() { assert_eq!("}", "}"); }
    #[test]
    fn b<'a>(_x: &'a str) { let _ = r#"}"#; /* /* } */ */ }
    #[test]
    fn esc(c: char) { if c == '\\\\' || c == '\\'' { return; } }
    #[test]
    fn c() {}
}
#[cfg(test)]
fn helper() -> [u8; 4] {
    [0; 4]
}
#[cfg(test)]
use std::collections::{HashMap, HashSet};
#[cfg(test)]
const CFG_OBJ: S = S {
    a: 1,
};
#[cfg(test)]
const LIMIT: bool = 1 < 2;
#[cfg(test)]
const MASK: usize = 1 << 8;
#[cfg(test)]
const
fn multiline_const_fn() -> i32 {
    1
}
#[cfg(test)]
fn const_generic() -> Arr<{ 1 }> {
    let x = 1;
    Arr
}
#[cfg(test)]
fn const_generic_lt() -> Arr<{ 1 < 2 }> {
    Arr
}
"""


def run(source: Path, ceiling: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [str(DECAY), str(source), str(ceiling)],
        cwd=ROOT, capture_output=True, text=True,
    )


def main() -> int:
    failures: list[str] = []
    ran = [0]

    def expect(name: str, cond: bool, detail: str = "") -> None:
        ran[0] += 1
        if cond:
            print(f"  ok    {name}")
        else:
            print(f"  FAIL  {name}  {detail}")
            failures.append(name)

    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        src = tmp / "core"
        src.mkdir()
        (src / "lib.rs").write_text(BODY, encoding="utf-8")

        # Establish what the script counts, rather than asserting a number the
        # comment-stripping rules might legitimately change.
        seal = tmp / "sealed"
        first = run(src, seal)
        expect("a missing ceiling seals itself", first.returncode == 0 and seal.exists(),
               first.stdout + first.stderr)
        actual = int(seal.read_text().strip())
        expect("the sealed count is a positive number", actual > 0, f"got {actual}")

        at = tmp / "at"
        at.write_text(f"{actual}\n")
        r = run(src, at)
        expect("a core at the ceiling passes", r.returncode == 0, r.stderr)
        expect("and says so", "at the ceiling" in r.stdout, r.stdout)

        low = tmp / "low"
        low.write_text(f"{actual - 1}\n")
        r = run(src, low)
        expect("a core above the ceiling FAILS", r.returncode == 1, "it did not fail")
        expect("and says how far over", "the trusted core grew" in r.stderr, r.stderr)
        expect("and offers both remedies",
               "take 1 lines back" in r.stderr and "raise the ceiling" in r.stderr, r.stderr)

        (src / "lib.rs").write_text(BODY + TESTS, encoding="utf-8")
        r = run(src, at)
        expect("adding tests does not grow the core", r.returncode == 0, r.stderr)

        # A `#[cfg(test)]` that is not last. Deleting from the first marker to
        # the end of the file made one attribute at the top of a file remove
        # the file from the count, which turned the rule off.
        (src / "lib.rs").write_text(TESTS + BODY, encoding="utf-8")
        seal2 = tmp / "sealed2"
        r = run(src, seal2)
        expect("a test module that is not last hides nothing",
               r.returncode == 0 and int(seal2.read_text().strip()) == actual,
               f"{seal2.read_text().strip() if seal2.exists() else 'nothing'}, wanted {actual}")

        head, tail = BODY.split("fn two() {}\n")
        (src / "lib.rs").write_text(head + TESTS + "fn two() {}\n" + tail, encoding="utf-8")
        seal3 = tmp / "sealed3"
        r = run(src, seal3)
        expect("nor one in the middle",
               r.returncode == 0 and int(seal3.read_text().strip()) == actual,
               f"{seal3.read_text().strip() if seal3.exists() else 'nothing'}, wanted {actual}")

        (src / "lib.rs").write_text(BODY, encoding="utf-8")

        # Literal-only core lines must still count toward the ceiling.
        lit_src = tmp / "lit"
        lit_src.mkdir()
        (lit_src / "lib.rs").write_text('fn msg() -> &\'static str {\n    "hello"\n}\n', encoding="utf-8")
        lit_seal = tmp / "lit_sealed"
        lit_r = run(lit_src, lit_seal)
        expect("literal-only core lines are counted",
               lit_r.returncode == 0 and int(lit_seal.read_text().strip()) == 3,
               f"got {lit_seal.read_text().strip() if lit_seal.exists() else lit_r.stderr}")

        # A ceiling that is not a number. Without a check the comparisons fail
        # and the script reports success, so an empty file turns the rule off
        # and says nothing.
        for idx, junk in enumerate(["", "\n", "not a number\n", "10 lines\n20\n"]):
            empty = tmp / f"empty{idx}"
            empty.write_text(junk)
            r = run(src, empty)
            expect(f"a ceiling of {junk!r} FAILS", r.returncode == 1, r.stdout + r.stderr)
            expect("and says the core's size instead",
                   f"{actual} lines" in r.stderr, r.stderr)

        r = run(tmp / "missing-dir", at)
        expect("a missing source directory FAILS", r.returncode == 1, r.stdout + r.stderr)

        # Production modules nested under `src/tests/` or `src/target/` must be counted (H29).
        nested_src = tmp / "nested"
        (nested_src / "crate_a" / "src" / "tests").mkdir(parents=True)
        (nested_src / "crate_a" / "src" / "target").mkdir(parents=True)
        (nested_src / "crate_a" / "tests").mkdir(parents=True)
        (nested_src / "crate_a" / "src" / "tests" / "mod.rs").write_text("pub fn a() {}\n", encoding="utf-8")
        (nested_src / "crate_a" / "src" / "target" / "mod.rs").write_text("pub fn b() {}\n", encoding="utf-8")
        (nested_src / "crate_a" / "tests" / "integ.rs").write_text("fn integ() {}\n", encoding="utf-8")
        nested_seal = tmp / "nested_sealed"
        nested_r = run(nested_src, nested_seal)
        expect("production modules under src/tests and src/target are counted",
               nested_r.returncode == 0 and int(nested_seal.read_text().strip()) == 2,
               f"got {nested_seal.read_text().strip() if nested_seal.exists() else nested_r.stderr}")

        high = tmp / "high"
        high.write_text(f"{actual + 10}\n")
        r = run(src, high)
        expect("a core below the ceiling passes", r.returncode == 0, r.stderr)
        expect("and prints the command to lower it",
               f"echo {actual} >" in r.stdout, r.stdout)

        # Default `.decay-ceiling` missing: must refuse without `--init`, and
        # seal itself when `--init` is passed explicitly.
        repo_tmp = tmp / "repo"
        (repo_tmp / "scripts").mkdir(parents=True)
        (repo_tmp / "crates" / "core" / "src").mkdir(parents=True)
        shutil.copy2(DECAY, repo_tmp / "scripts" / "decay")
        (repo_tmp / "crates" / "core" / "src" / "lib.rs").write_text(BODY, encoding="utf-8")
        default_ceiling = repo_tmp / ".decay-ceiling"

        r_refuse = subprocess.run(
            [str(repo_tmp / "scripts" / "decay")],
            cwd=repo_tmp, capture_output=True, text=True,
        )
        expect("missing default .decay-ceiling refuses to bypass",
               r_refuse.returncode == 1 and not default_ceiling.exists(),
               r_refuse.stdout + r_refuse.stderr)
        expect("and suggests restoring or --init",
               "--init" in r_refuse.stderr, r_refuse.stderr)

        r_init = subprocess.run(
            [str(repo_tmp / "scripts" / "decay"), "--init"],
            cwd=repo_tmp, capture_output=True, text=True,
        )
        expect("default .decay-ceiling seals with --init",
               r_init.returncode == 0 and default_ceiling.is_file()
               and int(default_ceiling.read_text(encoding="utf-8").strip()) == actual,
               r_init.stdout + r_init.stderr)

    print(f"decay: {ran[0] - len(failures)}/{ran[0]} checks passed")
    if failures:
        print(f"decay: {len(failures)} check(s) failed", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
