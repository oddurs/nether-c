#!/usr/bin/env python3
"""`scripts/notes` cuts the right section out of a changelog.

A release is published with whatever this returns, so the ways it can be wrong
are all expensive: notes belonging to the previous version, notes with the
heading's date as their first line, or `Unreleased` going out as a release.
"""

import importlib.machinery
import importlib.util
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[2]

# `scripts/notes` has no extension, so it is loaded by path rather than
# imported. It is a sibling script, not a package.
_loader = importlib.machinery.SourceFileLoader("notes", str(ROOT / "scripts" / "notes"))
_spec = importlib.util.spec_from_loader("notes", _loader)
_notes = importlib.util.module_from_spec(_spec)
_loader.exec_module(_notes)
notes = _notes.notes

SAMPLE = """# Changelog

Preamble that is not a release.

## [Unreleased]

### Added

- Something still descending.

```markdown
## [0.2.0] - fenced example must be ignored
```

## [0.2.0] - 2027-01-02

### Added

- The second thing.

### Fixed

- A thing that was wrong.

````markdown
```
## Still inside 4-backtick fence
```
~~~
## Still inside 4-backtick fence after tilde
````

## [0.1.0] - 2026-12-01

### Added

- The first thing.

    ```
    4-space indented code block is not a fence

[0.2.0]: https://example.invalid/releases/tag/v0.2.0
[0.1.0]: https://example.invalid/releases/tag/v0.1.0
"""

CASES = [
    ("the newest version stops at the next heading",
     "v0.2.0", lambda r: r.startswith("### Added") and "The second thing." in r
     and "A thing that was wrong." in r and "The first thing." not in r),
    ("the date on the heading is not part of the notes",
     "v0.2.0", lambda r: not r.startswith("-") and "2027-01-02" not in r),
    ("the oldest version stops before EOF reference links",
     "v0.1.0", lambda r: "The first thing." in r and "The second thing." not in r
     and "[0.1.0]:" not in r and "[0.2.0]:" not in r),
    ("a leading v is optional",
     "0.2.0", lambda r: r is not None and "The second thing." in r),
    ("unreleased content never leaks into a release",
     "v0.2.0", lambda r: "Something still descending." not in r),
    ("a version with no section is refused",
     "v9.9.9", lambda r: r is None),
    ("fenced headings inside notes do not truncate the section",
     "v0.2.0", lambda r: r is not None and "## Still inside 4-backtick fence after tilde" in r
     and "fenced example must be ignored" not in r),
    ("repeated leading v is not stripped",
     "vv0.2.0", lambda r: r is None),
]


def main() -> int:
    bad = []
    for name, version, ok in CASES:
        got = notes(SAMPLE, version)
        try:
            passed = ok(got)
        except TypeError:            # ok() on None where a string was expected
            passed = False
        print(f"  {'ok  ' if passed else 'FAIL'}  {name}")
        if not passed:
            bad.append((name, got))

    # A 4-space indented ``` must not toggle fence state and swallow the next section.
    indented_sample = (
        "## [0.2.0] - 2027-01-02\n\n"
        "    ```\n"
        "    indented code block\n\n"
        "## [0.1.0] - 2026-12-01\n\n"
        "- Old note.\n"
    )
    got_ind = notes(indented_sample, "v0.2.0")
    ok_ind = got_ind is not None and "Old note." not in got_ind
    print(f"  {'ok  ' if ok_ind else 'FAIL'}  4-space indented fence does not swallow next heading")
    if not ok_ind:
        bad.append(("4-space indented fence does not swallow next heading", got_ind))

    # `Unreleased` is refused by the command, not by the function: the function
    # would happily find that section, and the guard is one line above it.
    if notes(SAMPLE, "Unreleased") is None:
        bad.append(("the sample has an Unreleased section to guard against", None))
    if _notes.main(["scripts/notes", "Unreleased"]) != 1:
        bad.append(("CLI refuses Unreleased", None))
    if _notes.main(["scripts/notes", "v9.9.9"]) != 1:
        bad.append(("CLI refuses missing version", None))
    if _notes.main(["scripts/notes"]) != 2:
        bad.append(("CLI exits 2 on missing version arg", None))
    if _notes.main(["scripts/notes", "v0.1.0", "extra"]) != 2:
        bad.append(("CLI exits 2 on extra arg", None))

    # Real CHANGELOG.md must yield non-empty notes for shipped releases.
    for shipped in ("v0.1.0", "v0.2.0", "v0.3.0"):
        if _notes.main(["scripts/notes", shipped]) != 0:
            bad.append((f"real CHANGELOG.md has notes for {shipped}", None))

    # Empty section in a changelog must be refused with exit 1.
    orig_changelog = _notes.CHANGELOG
    try:
        with tempfile.TemporaryDirectory() as tmp:
            empty_log = Path(tmp) / "CHANGELOG.md"
            empty_log.write_text("# Changelog\n\n## [0.3.0] - 2027-01-03\n\n## [0.2.0]\n\n- ok\n", encoding="utf-8")
            _notes.CHANGELOG = empty_log
            if _notes.main(["scripts/notes", "v0.3.0"]) != 1:
                bad.append(("CLI exits 1 on empty version section", None))
    finally:
        _notes.CHANGELOG = orig_changelog

    if bad:
        print("\nnotes: the release notes would have been wrong:", file=sys.stderr)
        for name, got in bad:
            print(f"  {name}\n    got: {str(got)[:120]!r}", file=sys.stderr)
        return 1
    print(f"notes: {len(CASES)} case(s), the right section every time")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
